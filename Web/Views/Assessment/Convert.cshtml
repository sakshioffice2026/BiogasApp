@model BiogasApp.Model.DTOs.ConvertAssessmentDto
@{
    ViewData["Title"] = "Convert to project";
    var name = ViewBag.AssessmentName as string ?? string.Empty;
}

<div class="bp-page-head">
    <div>
        <h1>Convert to project</h1>
        <p class="bp-muted mb-0">Assessment: @name. The plot, receptors, no-build zones and equipment are copied to the new project. The assessment is then locked.</p>
    </div>
</div>

<form method="post" asp-action="Convert" class="bp-card p-4" style="max-width: 640px">
    <input type="hidden" asp-for="AssessmentId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label class="form-label" asp-for="ProjectName">Project name</label>
        <input class="form-control" asp-for="ProjectName" maxlength="150" />
        <span class="text-danger small" asp-validation-for="ProjectName"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="LocationCountry">Country</label>
            <input class="form-control" asp-for="LocationCountry" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="RegulatoryStandard">Regulatory standard</label>
            <select class="form-select" asp-for="RegulatoryStandard">
                <option value="PesoIndia">PESO (India)</option>
                <option value="AtexEu">ATEX (EU)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="AmbientTempMinC">Ambient minimum (&deg;C)</label>
            <input class="form-control" asp-for="AmbientTempMinC" type="number" step="any" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="AmbientTempMaxC">Ambient maximum (&deg;C)</label>
            <input class="form-control" asp-for="AmbientTempMaxC" type="number" step="any" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="DigesterRegime">Digester regime</label>
            <select class="form-select" asp-for="DigesterRegime">
                <option value="Mesophilic">Mesophilic</option>
                <option value="Thermophilic">Thermophilic</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="UpgradingTech">Upgrading technology</label>
            <select class="form-select" asp-for="UpgradingTech">
                <option value="Psa">PSA</option>
                <option value="Membrane">Membrane</option>
                <option value="Hpws">HPWS</option>
            </select>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Convert to project</button>
        <a class="btn btn-outline-secondary" asp-action="Editor" asp-route-id="@Model.AssessmentId">Back to layout</a>
    </div>
</form>
