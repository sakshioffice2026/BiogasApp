@{
    ViewData["Title"] = "Reset password";
    var token = ViewData["Token"] as string ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}

<div class="ac-shell bp-glass">
    <aside class="ac-brand" aria-label="About BiogasApp">
        <p class="ac-brand__kicker">Account security</p>
        <h2 class="ac-brand__title">Get back to designing your biogas plant.</h2>
        <ol class="ac-pipe" role="list">
            <li class="ac-pipe__node">
                <span class="ac-pipe__dot" aria-hidden="true">
                    <svg class="bp-ico" viewBox="0 0 24 24">
                        <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14M5 19c3-4 6-7 10-9" />
                    </svg>
                </span>
                <span class="ac-pipe__text">
                    <strong>Secure access</strong>
                    <small>Protect your workspace</small>
                </span>
            </li>
            <li class="ac-pipe__node">
                <span class="ac-pipe__dot" aria-hidden="true">
                    <svg class="bp-ico" viewBox="0 0 24 24">
                        <path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <span class="ac-pipe__text">
                    <strong>New password</strong>
                    <small>Choose a secure password</small>
                </span>
            </li>
        </ol>
    </aside>

    <section class="ac-panel" aria-labelledby="ac-title">
        <h1 class="ac-title" id="ac-title">Reset password</h1>
        <p class="bp-muted">Enter your email and choose a new password.</p>

        <form asp-action="ResetPassword" method="post" class="ac-form" data-ac-form>
            <div asp-validation-summary="ModelOnly"
                 class="bp-toast bp-toast--error"
                 role="alert"></div>

            <input type="hidden" name="Token" value="@token" />

            <div class="ac-field">
                <label for="Email" class="form-label">Email address</label>
                <input id="Email"
                       name="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       inputmode="email"
                       required
                       autofocus
                       placeholder="you@company.com" />
            </div>

            <div class="ac-field">
                <label for="Password" class="form-label">New password</label>
                <div class="ac-secret">
                    <input id="Password"
                           name="Password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="8"
                           required />
                    <button type="button"
                            class="ac-toggle"
                            data-ac-toggle
                            aria-controls="Password"
                            aria-pressed="false">
                        <span data-ac-toggle-text>Show</span>
                    </button>
                </div>
            </div>

            <div class="ac-field">
                <label for="ConfirmPassword" class="form-label">
                    Confirm new password
                </label>
                <div class="ac-secret">
                    <input id="ConfirmPassword"
                           name="ConfirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="8"
                           required />
                    <button type="button"
                            class="ac-toggle"
                            data-ac-toggle
                            aria-controls="ConfirmPassword"
                            aria-pressed="false">
                        <span data-ac-toggle-text>Show</span>
                    </button>
                </div>
            </div>

            <button type="submit"
                    class="bp-btn bp-btn--primary ac-submit"
                    data-ac-submit>
                <span data-ac-submit-text>Reset password</span>
            </button>
        </form>

        <p class="ac-switch">
            Remember your password?
            <a asp-action="Login">Sign in</a>
        </p>
    </section>
</div>