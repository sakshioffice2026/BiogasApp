@using BiogasApp.Database.Enums
@using BiogasApp.Repositories.Contracts
@model BiogasApp.Model.ViewModel.EnquiryDetailsViewModel
@inject IEnquiryProposalRepository ProposalRepo
@inject IAssessmentRepository AssessmentRepo
@{
    ViewData["Title"] = Model.EnquiryNo;

    var proposals = await ProposalRepo.GetByEnquiryAsync(Model.Id);
    var assessment = (await AssessmentRepo.GetListAsync()).FirstOrDefault(a => a.EnquiryId == Model.Id);
    var latestProposal = proposals.OrderByDescending(x => x.Version).FirstOrDefault();
    var assessmentConverted = assessment != null && assessment.Status == "Converted";

    string ProposalCss(ProposalStatus s) => s switch
    {
        ProposalStatus.Draft => "draft",
        ProposalStatus.Sent => "simulated",
        ProposalStatus.Approved => "approved",
        _ => "archived"
    };

    string StatusLabel(EnquiryStatus s) => s switch
    {
        EnquiryStatus.UnderReview => "Under Review",
        EnquiryStatus.ProposalSent => "Proposal Sent",
        _ => s.ToString()
    };

    string StatusCss(EnquiryStatus s) => s switch
    {
        EnquiryStatus.New => "draft",
        EnquiryStatus.UnderReview => "simulated",
        EnquiryStatus.ProposalSent => "simulated",
        EnquiryStatus.Revised => "draft",
        EnquiryStatus.Approved => "approved",
        EnquiryStatus.Rejected => "archived",
        _ => "draft"
    };
}

<div class="bp-page-head">
    <div>
        <span class="bp-chip bp-chip--@(StatusCss(Model.Status))">@StatusLabel(Model.Status)</span>
        <h1 class="mt-2">@Model.EnquiryNo</h1>
        <p class="bp-muted mb-0">
            Received @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") via @Model.Source
            @if (Model.UpdatedAt.HasValue)
            {
                <text> &middot; Updated @Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")</text>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="bp-btn bp-btn--ghost" asp-action="Index">Back to enquiries</a>
        <a class="bp-btn bp-btn--primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        @if (assessment == null)
        {
            <a class="bp-btn bp-btn--flame" asp-controller="Assessment" asp-action="Create" asp-route-enquiryId="@Model.Id">Create site assessment</a>
        }
        else if (!assessmentConverted)
        {
            <a class="bp-btn bp-btn--flame" asp-controller="EnquiryProposal" asp-action="Create" asp-route-enquiryId="@Model.Id">
                @(proposals.Count == 0 ? "Create Proposal" : "Revise Proposal")
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <section class="bp-card p-4 mb-3">
            <h2 class="h5 mb-3">Customer</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.CustomerName</dd>
                <dt class="col-sm-4">Company</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8"><a href="tel:@Model.Phone">@Model.Phone</a></dd>
            </dl>
        </section>

        <section class="bp-card p-4 mb-3">
            <h2 class="h5 mb-3">Site location</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">City</dt>
                <dd class="col-sm-8">@Model.LocationCity</dd>
                <dt class="col-sm-4">State</dt>
                <dd class="col-sm-8">@Model.LocationState</dd>
                <dt class="col-sm-4">Country</dt>
                <dd class="col-sm-8">@Model.LocationCountry</dd>
            </dl>
        </section>

        <section class="bp-card p-4">
            <h2 class="h5 mb-3">Requirement</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Feedstock</dt>
                <dd class="col-sm-8">@Model.FeedstockType</dd>
                <dt class="col-sm-4">Quantity</dt>
                <dd class="col-sm-8">@Model.FeedstockQtyTpd.ToString("0.##") TPD</dd>
                <dt class="col-sm-4">End use</dt>
                <dd class="col-sm-8">@Model.EndUse</dd>
                <dt class="col-sm-4">Message</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Message) ? "-" : Model.Message)</dd>
            </dl>
        </section>

        <section class="bp-card p-4 mt-3">
            <h2 class="h5 mb-3">Site assessment</h2>
            @if (assessment == null)
            {
                <p class="mb-2">No site assessment yet.</p>
                <p class="bp-muted mb-3">Next step: create the site assessment (location, plot, receptors, layout). The proposal is created after that.</p>
                <a class="bp-btn bp-btn--primary" asp-controller="Assessment" asp-action="Create" asp-route-enquiryId="@Model.Id">Create site assessment</a>
            }
            else
            {
                <dl class="row mb-3">
                    <dt class="col-sm-4">Assessment</dt>
                    <dd class="col-sm-8">@assessment.Name</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="bp-chip bp-chip--@(assessmentConverted ? "approved" : "draft")">@assessment.Status</span></dd>
                    <dt class="col-sm-4">Plot</dt>
                    <dd class="col-sm-8">@(assessment.PlotAreaM2 > 0 ? assessment.PlotAreaM2.ToString("N0") + " m2" : "Not entered")</dd>
                    <dt class="col-sm-4">Receptors</dt>
                    <dd class="col-sm-8">@assessment.ReceptorCount (@assessment.SensitiveReceptorCount sensitive)</dd>
                    <dt class="col-sm-4">Layout versions</dt>
                    <dd class="col-sm-8">@assessment.LayoutVersionCount</dd>
                    <dt class="col-sm-4">Proposal</dt>
                    <dd class="col-sm-8">@(latestProposal == null ? "Not created" : latestProposal.ProposalNo + " (" + latestProposal.Status + ")")</dd>
                </dl>

                @if (assessmentConverted)
                {
                    <p class="bp-muted mb-3">Next step: continue in the project.</p>
                    @if (assessment.ProjectId.HasValue)
                    {
                        <a class="bp-btn bp-btn--primary" asp-controller="Project" asp-action="Detail" asp-route-id="@assessment.ProjectId">Open project</a>
                    }
                }
                else if (assessment.ProposalApproved)
                {
                    <p class="bp-muted mb-3">Next step: the proposal is approved, convert the assessment to a project.</p>
                    <a class="bp-btn bp-btn--primary" asp-controller="Assessment" asp-action="Convert" asp-route-id="@assessment.Id">Convert to project</a>
                }
                else if (latestProposal == null)
                {
                    <p class="bp-muted mb-3">Next step: finish the site and layout, then create the proposal.</p>
                    <div class="d-flex gap-2">
                        <a class="bp-btn bp-btn--ghost" asp-controller="Assessment" asp-action="Site" asp-route-id="@assessment.Id">Site</a>
                        <a class="bp-btn bp-btn--ghost" asp-controller="Assessment" asp-action="Editor" asp-route-id="@assessment.Id">Layout</a>
                        <a class="bp-btn bp-btn--primary" asp-controller="EnquiryProposal" asp-action="Create" asp-route-enquiryId="@Model.Id">Create Proposal</a>
                    </div>
                }
                else if (latestProposal.Status == ProposalStatus.Rejected)
                {
                    <p class="bp-muted mb-3">Next step: the proposal was rejected, revise it.</p>
                    <a class="bp-btn bp-btn--primary" asp-controller="EnquiryProposal" asp-action="Create" asp-route-enquiryId="@Model.Id">Revise Proposal</a>
                }
                else
                {
                    <p class="bp-muted mb-3">Next step: wait for the proposal to be Approved.</p>
                    <a class="bp-btn bp-btn--primary" asp-controller="EnquiryProposal" asp-action="Details" asp-route-id="@latestProposal.Id">Open proposal</a>
                }
            }
        </section>

        <section class="bp-card p-4 mt-3">
            <h2 class="h5 mb-3">Proposals</h2>
            @if (proposals.Count == 0)
            {
                <p class="bp-muted mb-0">No proposal created yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Proposal</th>
                                <th>Version</th>
                                <th>Status</th>
                                <th class="text-end">CAPEX</th>
                                <th class="text-end">IRR</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in proposals.OrderByDescending(x => x.Version))
                            {
                                <tr>
                                    <td>@p.ProposalNo</td>
                                    <td>v@(p.Version)</td>
                                    <td><span class="bp-chip bp-chip--@(ProposalCss(p.Status))">@p.Status</span></td>
                                    <td class="text-end">@p.CapexTotal.ToString("N0")</td>
                                    <td class="text-end">@(p.IrrPercent.HasValue? p.IrrPercent.Value.ToString("0.##") + " %" : "-")</td>
                                    <td>@p.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="EnquiryProposal" asp-action="Details" asp-route-id="@p.Id">Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-lg-4">
        <section class="bp-card p-4">
            <h2 class="h5 mb-3">Status</h2>
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="mb-3">
                    <label for="enq-status" class="form-label">Update status</label>
                    <select id="enq-status" name="Status" class="form-select">
                        @foreach (var s in Enum.GetValues<EnquiryStatus>())
                        {
                            <option value="@((int)s)" selected="@(Model.Status == s)">@StatusLabel(s)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="enq-notes" class="form-label">Admin notes</label>
                    <textarea id="enq-notes" name="AdminNotes" rows="5" maxlength="2000" class="form-control">@Model.AdminNotes</textarea>
                </div>

                <button type="submit" class="bp-btn bp-btn--flame w-100">Save status</button>
            </form>
        </section>
    </div>
</div>