@using BiogasApp.Database.Enums
@using Web.Helpers
@model BiogasApp.Model.DTOs.DashboardOverviewDto
@{
    ViewData["Title"] = "Overview";

    var counts = Model.ProjectStatusCounts;
    int Count(ProjectStatus s) => counts.TryGetValue(s, out var c) ? c : 0;

    var canAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("ClientAdmin");
    var kpi = Model.Kpis;
}
@section Styles {
    <style>
        .db-wrap {
            display: grid;
            gap: 22px;
        }

        .db-hero {
            padding: 28px;
            border-radius: 24px;
            background: linear-gradient(120deg,#0f766e,#1d4ed8);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

            .db-hero h1 {
                font-size: clamp(1.6rem,3vw,2.4rem);
                font-weight: 800;
                margin: 0 0 8px;
            }

            .db-hero p {
                margin: 0;
                opacity: .88;
            }

        .db-hero-latest {
            margin-top: 10px;
            font-size: .88rem;
            opacity: .95;
        }

            .db-hero-latest strong {
                font-weight: 700;
            }

        .db-hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .db-hero .bp-btn {
            text-decoration: none;
        }

        .db-grid {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 16px;
        }

        .db-stat {
            padding: 20px;
            border: 1px solid var(--bp-line);
            border-radius: 18px;
            background: rgba(255,255,255,.8);
            box-shadow: var(--bp-shadow-sm);
        }

        .db-stat-label {
            color: var(--bp-ink-mute);
            font-size: .86rem;
            font-weight: 600;
        }

        .db-stat-value {
            font-size: 1.8rem;
            font-weight: 800;
            margin: 8px 0;
            color: var(--bp-ink);
        }

            .db-stat-value small {
                font-size: .8rem;
                font-weight: 600;
                color: var(--bp-ink-mute);
                margin-left: 4px;
            }

        .db-stat-note {
            color: var(--bp-ink-mute);
            font-size: .8rem;
        }

        .db-section {
            padding: 22px;
            border: 1px solid var(--bp-line);
            border-radius: 20px;
            background: rgba(255,255,255,.8);
        }

            .db-section h2 {
                font-size: 1.15rem;
                font-weight: 750;
                margin: 0 0 16px;
            }

        .db-sub {
            color: var(--bp-ink-mute);
            font-size: .85rem;
            margin: -10px 0 14px;
        }

        .db-cols-even {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 22px;
        }

        .db-pills {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 12px;
        }

        .db-pill {
            padding: 14px 16px;
            border-radius: 14px;
            background: rgba(248,250,252,.9);
            border: 1px solid var(--bp-line);
            border-left-width: 4px;
        }

            .db-pill span {
                display: block;
                font-size: .8rem;
                color: var(--bp-ink-mute);
            }

            .db-pill strong {
                display: block;
                font-size: 1.4rem;
                font-weight: 800;
                margin-top: 4px;
            }

        .db-pill--draft {
            border-left-color: #64748b;
        }

        .db-pill--simulated {
            border-left-color: #0ea5e9;
        }

        .db-pill--approved {
            border-left-color: #16a34a;
        }

        .db-pill--archived {
            border-left-color: #a16207;
        }

        .db-pill--violet {
            border-left-color: #8b5cf6;
        }

        .db-pill--red {
            border-left-color: #e11d48;
        }

        .db-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 12px;
        }

        .db-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .db-links .bp-btn {
                text-decoration: none;
                padding: 5px 12px;
                font-size: .8rem;
            }

        .db-approve {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

            .db-approve strong {
                display: block;
                font-size: .92rem;
            }

            .db-approve span {
                font-size: .78rem;
                color: var(--bp-ink-mute);
            }

        .db-empty-note {
            color: var(--bp-ink-mute);
            font-size: .9rem;
            padding: 14px;
            border: 1px dashed var(--bp-line);
            border-radius: 14px;
            text-align: center;
        }

        .db-pid {
            display: grid;
            gap: 16px;
            position: relative;
            overflow: hidden;
        }

            .db-pid::before {
                content: "";
                position: absolute;
                inset: 0 0 auto 0;
                height: 4px;
                background: var(--bp-grad-flow);
            }

            .db-pid h2 {
                margin-bottom: 6px;
            }

            .db-pid p {
                margin: 0;
                color: var(--bp-ink-mute);
            }

        .db-pid-eyebrow {
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-indigo);
        }

        .db-pid-flow {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 10px 0;
            align-items: center;
        }

            .db-pid-flow li {
                position: relative;
                margin-right: 28px;
                padding: 8px 16px;
                border-radius: 999px;
                border: 1px solid var(--bp-line);
                background: #fff;
                color: var(--bp-ink-soft);
                font-size: .86rem;
                font-weight: 600;
                box-shadow: var(--bp-shadow);
            }

                .db-pid-flow li:not(:last-child)::after {
                    content: "";
                    position: absolute;
                    left: 100%;
                    top: 50%;
                    width: 28px;
                    height: 2px;
                    background: var(--bp-grad-flow);
                    transform: translateY(-50%);
                }

                .db-pid-flow li:not(:last-child)::before {
                    content: "";
                    position: absolute;
                    left: calc(100% + 19px);
                    top: 50%;
                    width: 7px;
                    height: 7px;
                    border-top: 2px solid var(--bp-cyan);
                    border-right: 2px solid var(--bp-cyan);
                    transform: translateY(-50%) rotate(45deg);
                    z-index: 1;
                }

                .db-pid-flow li:last-child {
                    margin-right: 0;
                    background: var(--bp-grad-flow);
                    border-color: transparent;
                    color: #fff;
                }

        @@media(max-width:1000px) {
            .db-cols-even {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:900px) {
            .db-grid, .db-pills {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }
        }

        @@media(max-width:560px) {
            .db-grid, .db-pills {
                grid-template-columns: 1fr;
            }

            .db-hero {
                padding: 22px;
            }

            .db-section {
                padding: 16px;
            }
        }
    </style>
}

<div class="db-wrap">

    <section class="db-hero">
        <div>
            <h1>Plant engineering overview</h1>
            <p>Manage projects, run biogas simulations and move toward plant design.</p>
            @if (Model.FeaturedProjectId.HasValue && !string.IsNullOrEmpty(Model.FeaturedProjectName))
            {
                <div class="db-hero-latest">Latest project: <strong>@Model.FeaturedProjectName</strong></div>
            }
        </div>
        <div class="db-hero-actions">
            <a class="bp-btn bp-btn--primary" asp-controller="Project" asp-action="Create">+ New project</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Project" asp-action="Index">View projects</a>
            @if (Model.FeaturedRunId.HasValue)
            {
                <a class="bp-btn bp-btn--ghost" asp-controller="Simulation" asp-action="Dashboard" asp-route-runId="@Model.FeaturedRunId">Open latest simulation</a>
            }
        </div>
    </section>

    <section class="db-grid" aria-label="Plant totals">
        <article class="db-stat">
            <div class="db-stat-label">Total projects</div>
            <div class="db-stat-value">@Model.TotalProjects</div>
            <div class="db-stat-note">@Model.TotalRuns simulation runs in total</div>
        </article>
        <article class="db-stat">
            <div class="db-stat-label">Feed handled</div>
            <div class="db-stat-value">@kpi.TotalFeedTpd.ToString("N1")<small>TPD</small></div>
            <div class="db-stat-note">Latest run of @kpi.ProjectsCounted projects</div>
        </article>
        <article class="db-stat">
            <div class="db-stat-label">Raw biogas</div>
            <div class="db-stat-value">@kpi.RawBiogasNm3Day.ToString("N0")<small>Nm&sup3;/day</small></div>
            <div class="db-stat-note">Across simulated projects</div>
        </article>
        <article class="db-stat">
            <div class="db-stat-label">Net CBG</div>
            <div class="db-stat-value">@kpi.NetCbgKgDay.ToString("N0")<small>kg/day</small></div>
            <div class="db-stat-note">Parasitic power @kpi.ParasiticPowerKw.ToString("N0") kW</div>
        </article>
    </section>

    <section class="db-section">
        <h2>Project pipeline</h2>
        <div class="db-pills">
            <article class="db-pill db-pill--draft"><span>Draft</span><strong>@Count(ProjectStatus.Draft)</strong></article>
            <article class="db-pill db-pill--simulated"><span>Simulated</span><strong>@Count(ProjectStatus.Simulated)</strong></article>
            <article class="db-pill db-pill--approved"><span>Approved</span><strong>@Count(ProjectStatus.Approved)</strong></article>
            <article class="db-pill db-pill--archived"><span>Archived</span><strong>@Count(ProjectStatus.Archived)</strong></article>
        </div>
    </section>

    <section class="db-section">
        <h2>Waiting for approval</h2>
        <p class="db-sub">P&amp;ID drawings submitted for review.</p>
        @if (Model.PendingPids.Count == 0)
        {
            <div class="db-empty-note">Nothing is waiting for review.</div>
        }
        else
        {
            <ul class="db-list">
                @foreach (var x in Model.PendingPids)
                {
                    <li class="db-approve">
                        <div>
                            <strong>@x.DrawingNo &middot; Rev @x.RevisionNo</strong>
                            <span>@x.ProjectName @(x.UpdatedAt.HasValue ? "- " + x.UpdatedAt.Value.ToString("dd MMM, HH:mm") : "")</span>
                        </div>
                        <a class="bp-btn bp-btn--ghost" asp-controller="Pid" asp-action="Editor" asp-route-id="@x.PidDiagramId">Review</a>
                    </li>
                }
            </ul>
        }
    </section>

    <div class="db-cols-even">
        <section class="db-section">
            <h2>Enquiries and proposals</h2>
            <p class="db-sub">@Model.Enquiries.Total enquiries received.</p>
            <div class="db-pills">
                <article class="db-pill db-pill--simulated"><span>New</span><strong>@Model.Enquiries.New</strong></article>
                <article class="db-pill db-pill--violet"><span>Under review</span><strong>@Model.Enquiries.UnderReview</strong></article>
                <article class="db-pill db-pill--approved"><span>Approved</span><strong>@Model.Enquiries.Approved</strong></article>
                <article class="db-pill db-pill--red"><span>Rejected</span><strong>@Model.Enquiries.Rejected</strong></article>
            </div>
            <p class="db-sub mt-3 mb-2">Proposals: @Model.Enquiries.ProposalsDraft draft, @Model.Enquiries.ProposalsSent sent, @Model.Enquiries.ProposalsApproved approved.</p>
            @if (canAdmin)
            {
                <div class="db-links mt-2">
                    <a class="bp-btn bp-btn--ghost" asp-controller="Enquiry" asp-action="Index">Open enquiries</a>
                </div>
            }
        </section>

        <section class="db-section">
            <h2>Site assessments</h2>
            <p class="db-sub">Plot surveys and site plans.</p>
            <div class="db-pills" style="grid-template-columns:repeat(3,minmax(0,1fr))">
                <article class="db-pill db-pill--draft"><span>Total</span><strong>@Model.Assessments.Total</strong></article>
                <article class="db-pill db-pill--simulated"><span>In draft</span><strong>@Model.Assessments.Draft</strong></article>
                <article class="db-pill db-pill--approved"><span>Converted</span><strong>@Model.Assessments.Converted</strong></article>
            </div>
            <div class="db-links mt-3">
                <a class="bp-btn bp-btn--ghost" asp-controller="Assessment" asp-action="Index">Open assessments</a>
            </div>
        </section>
    </div>

    <section class="db-section db-pid" aria-labelledby="db-pid-title">
        <div>
            <span class="db-pid-eyebrow">Process drawing</span>
            <h2 id="db-pid-title">P&amp;ID studio</h2>
            <p>Piping and instrumentation diagram: pipes, valves and sensors between your sized equipment, drawn automatically from a simulation run.</p>
        </div>
        <ol class="db-pid-flow" role="list">
            <li>Feed</li>
            <li>Pre-treatment</li>
            <li>Digestion</li>
            <li>Gas holding</li>
            <li>Upgrading</li>
            <li>CBG</li>
        </ol>
        <div class="db-hero-actions">
            @if (Model.FeaturedProjectId.HasValue)
            {
                <a class="bp-btn bp-btn--primary" asp-controller="Pid" asp-action="Index" asp-route-projectId="@Model.FeaturedProjectId" asp-route-runId="@Model.FeaturedRunId">Open P&amp;ID for @Model.FeaturedProjectName</a>
            }
            else
            {
                <a class="bp-btn bp-btn--primary" asp-controller="Project" asp-action="Index">Pick a project to draw</a>
            }
        </div>
    </section>

    <section class="db-section">
        <h2>Quick actions</h2>
        <div class="db-hero-actions">
            <a class="bp-btn bp-btn--primary" asp-controller="Project" asp-action="Create">Create project</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Project" asp-action="Index">Project library</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Feedstock" asp-action="Index">Feedstock catalog</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Assessment" asp-action="Index">Site assessments</a>
        </div>
    </section>

</div>