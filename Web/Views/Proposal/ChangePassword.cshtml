@model BiogasApp.Model.ViewModel.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}

<div class="bp-page-head">
    <div>
        <h1>Change password</h1>
        <p class="bp-muted mb-0">Use at least 8 characters</p>
    </div>
    <a class="bp-btn bp-btn--ghost" asp-action="Profile">Back to profile</a>
</div>

<section class="bp-card p-4" style="max-width:480px" aria-labelledby="cp-title">
    <h2 class="visually-hidden" id="cp-title">Change password form</h2>

    <form asp-action="ChangePassword" method="post" class="ac-form" data-ac-form>
        <div asp-validation-summary="ModelOnly" class="bp-toast bp-toast--error" role="alert"></div>

        <div class="ac-field mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <div class="ac-secret">
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" aria-required="true" autofocus />
                <button type="button" class="ac-toggle" data-ac-toggle aria-controls="@Html.IdFor(m => m.CurrentPassword)" aria-pressed="false">
                    <span data-ac-toggle-text>Show</span>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>

        <div class="ac-field mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <div class="ac-secret">
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <button type="button" class="ac-toggle" data-ac-toggle aria-controls="@Html.IdFor(m => m.NewPassword)" aria-pressed="false">
                    <span data-ac-toggle-text>Show</span>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>

        <div class="ac-field mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label"></label>
            <div class="ac-secret">
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <button type="button" class="ac-toggle" data-ac-toggle aria-controls="@Html.IdFor(m => m.ConfirmNewPassword)" aria-pressed="false">
                    <span data-ac-toggle-text>Show</span>
                </button>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="bp-btn bp-btn--primary ac-submit" data-ac-submit>
            <span data-ac-submit-text>Update password</span>
        </button>
    </form>
</section>
