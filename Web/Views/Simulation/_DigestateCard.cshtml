@model (BiogasApp.Model.DTOs.DigestateCivilDto Digestate, BiogasApp.Model.DTOs.CbgDispatchDto Dispatch)
@{
    var d = Model.Digestate;
    var p = Model.Dispatch;
    var hasDigestate = d.SolidCakeTpd > 0 || d.LiquidLfomTpd > 0 || d.ExcavationM3 > 0;
    var hasDispatch = p.CbgTonnesPerDay > 0 || p.TankerLoadsPerDay > 0;
}

<section class="sm-panel bp-card" id="sm-digestate" aria-labelledby="sm-dg-title">
    <h2 class="sm-card-title" id="sm-dg-title">Digestate, civils and dispatch</h2>

    @if (!hasDigestate && !hasDispatch)
    {
        <p class="bp-muted mb-0">Not available for this run. Run the simulation again to see these results.</p>
    }
    else
    {
        <dl class="sx-metrics">
            <div class="sx-metric"><dt>Solid cake</dt><dd>@d.SolidCakeTpd.ToString("N2") <small>TPD</small></dd></div>
            <div class="sx-metric"><dt>Liquid (LFOM)</dt><dd>@d.LiquidLfomTpd.ToString("N2") <small>TPD</small></dd></div>
            @if (hasDispatch)
            {
                <div class="sx-metric"><dt>Output per day</dt><dd>@p.CbgTonnesPerDay.ToString("N2") <small>tonnes</small></dd></div>
                <div class="sx-metric"><dt>Tanker loads</dt><dd>@p.TankerLoadsPerDay <small>per day</small></dd></div>
            }
        </dl>

        <div class="sx-cols">
            <div>
                <h3 class="sx-spec-title">Compressed biogas dispatch</h3>
                @if (!hasDispatch)
                {
                    <p class="bp-muted mb-0">Dispatch data was not saved for this run.</p>
                }
                else
                {
                    <dl class="sx-spec">
                        <div><dt>Output per year</dt><dd>@p.CbgTonnesPerYear.ToString("N0") tonnes</dd></div>
                        <div><dt>Tanker payload</dt><dd>@p.TankerPayloadKg.ToString("N0") kg</dd></div>
                        <div><dt>Fill time per tanker</dt><dd>@p.FillTimeHoursPerTanker.ToString("N1") hours</dd></div>
                        <div><dt>Cascade buffer</dt><dd>@p.BufferHoursAvailable.ToString("N1") hours</dd></div>
                    </dl>
                }
            </div>

            <div>
                <h3 class="sx-spec-title">Civil quantities</h3>
                <dl class="sx-spec">
                    <div><dt>Excavation</dt><dd>@d.ExcavationM3.ToString("N0") m&sup3;</dd></div>
                    <div><dt>RCC concrete</dt><dd>@d.RccConcreteM3.ToString("N0") m&sup3;</dd></div>
                    <div><dt>Structural steel and rebar</dt><dd>@d.SteelRebarTons.ToString("N0") tons</dd></div>
                </dl>
            </div>
        </div>
    }
</section>
