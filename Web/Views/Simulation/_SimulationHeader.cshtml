@*
    Shared header for Dashboard and Results.
    Usage:
    <partial name="_SimulationHeader" model='("Simulation results", Model.ProjectName, Model.RunVersion, Model.ProjectStatus.Css(), Model.ProjectStatus.Label(), Model.ProjectId, Model.SimulationRunId, "Dashboard")' />
    Page is "Dashboard" or "Results" and decides which menu items are shown.
*@
@model (string Title, string? ProjectName, int RunVersion, string? StatusCss, string? StatusLabel, Guid ProjectId, Guid RunId, string Page)
@{
    var isDashboard = string.Equals(Model.Page, "Dashboard", StringComparison.OrdinalIgnoreCase);
}

<header class="bp-page-head sx-head">
    <div class="sx-head__main">
        <h1 class="sx-head__title">@Model.Title</h1>
        <div class="sx-head__chips">
            @if (!string.IsNullOrWhiteSpace(Model.ProjectName))
            {
                <strong class="sx-head__project">@Model.ProjectName</strong>
            }
            <span class="bp-chip bp-chip--simulated">Run v@(Model.RunVersion)</span>
            @if (!string.IsNullOrWhiteSpace(Model.StatusLabel))
            {
                <span class="bp-chip bp-chip--@Model.StatusCss">@Model.StatusLabel</span>
            }
        </div>
    </div>

    <div class="sx-head-actions">
        @if (isDashboard)
        {
            <a class="bp-btn bp-btn--ghost" asp-action="Results" asp-route-runId="@Model.RunId">Full results</a>
        }
        else
        {
            <a class="bp-btn bp-btn--ghost" asp-action="Dashboard" asp-route-runId="@Model.RunId">Dashboard</a>
        }
    </div>
</header>

<nav class="sx-fab" aria-label="Simulation actions">
    @if (isDashboard)
    {
        <a class="sx-fab__btn" asp-action="Mixer" asp-route-projectId="@Model.ProjectId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4" /></svg><span>Adjust mixer</span></a>
    }
    <a class="sx-fab__btn" asp-action="History" asp-route-projectId="@Model.ProjectId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2" /></svg><span>History</span></a>
    @if (!isDashboard)
    {
        <a class="sx-fab__btn" asp-controller="Proposal" asp-action="Index" asp-route-runId="@Model.RunId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7" /></svg><span>Proposal</span></a>
    }
    <a class="sx-fab__btn" asp-controller="Layout" asp-action="Editor" asp-route-projectId="@Model.ProjectId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h18v18H3zM3 9h18M9 9v12" /></svg><span>Generate layout</span></a>
    @if (!isDashboard)
    {
        <a class="sx-fab__btn" asp-controller="Cad" asp-action="Index" asp-route-runId="@Model.RunId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h5v4H4zM15 14h5v4h-5zM9 8h4a2 2 0 0 1 2 2v4" /></svg><span>PFD drawing</span></a>
    }
    <a class="sx-fab__btn" asp-controller="Pid" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-runId="@Model.RunId"><svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v4M12 17v4M5 12h4M15 12h4M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" /></svg><span>@(isDashboard ? "Open P&ID" : "P&ID drawing")</span></a>
</nav>