@using System.Collections
@using System.Globalization
@using System.Text.RegularExpressions
@model BiogasApp.Model.DTOs.SimulationResultDto
@{
    ViewData["Title"] = $"Results v{Model.Version}";
    ViewData["RunId"] = Model.SimulationRunId;
    ViewData["WorkflowStep"] = 2;
    var mb = Model.MassBalance;
    var dk = Model.DigesterKinetics;
    var pt = Model.PreTreatment;
    var inv = CultureInfo.InvariantCulture;
    var other = Math.Max(0d, 100d - dk.Ch4Percent - dk.Co2Percent);
    var totalCost = Model.EquipmentSizing.Sum(e => e.TotalCost);
}
@functions {
    static string Humanize(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var text = value.Replace('_', ' ').ToLowerInvariant();
        return char.ToUpperInvariant(text[0]) + text.Substring(1);
    }

    static string KeyLabel(string key)
    {
        if (string.IsNullOrWhiteSpace(key)) return string.Empty;
        var text = Regex.Replace(key, "([a-z0-9])([A-Z])", "$1 $2");
        text = Regex.Replace(text, @"\s(M3)$", " (m\u00B3)");
        text = Regex.Replace(text, @"\s(M2)$", " (m\u00B2)");
        text = Regex.Replace(text, @"\sNm3 Hr$", " (Nm\u00B3/h)");
        text = Regex.Replace(text, @"\sKw$", " (kW)");
        text = Regex.Replace(text, @"\sMm Array$", " (mm)");
        text = Regex.Replace(text, @"\sMm$", " (mm)");
        text = Regex.Replace(text, @"\sLiters$", " (L)");
        text = Regex.Replace(text, @"\sM$", " (m)");
        text = text.Replace("Per Bank", "per bank");
        return char.ToUpperInvariant(text[0]) + text.Substring(1);
    }

    static string ValueText(object? value)
    {
        if (value is null) return "n/a";
        if (value is string s) return s;
        if (value is IEnumerable list)
        {
            var parts = new List<string>();
            foreach (var item in list)
            {
                parts.Add(item?.ToString() ?? "n/a");
            }

            return string.Join(", ", parts);
        }

        return value.ToString() ?? "n/a";
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/simulation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
    <style>
        .sx-head-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .sx-more {
            position: relative;
        }

            .sx-more > summary {
                list-style: none;
                cursor: pointer;
            }

                .sx-more > summary::-webkit-details-marker {
                    display: none;
                }

        .sx-more__menu {
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            min-width: 190px;
            display: flex;
            flex-direction: column;
            padding: 6px;
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: var(--bp-radius-sm);
            box-shadow: var(--bp-shadow-lg);
            z-index: 20;
        }

            .sx-more__menu a {
                padding: 9px 12px;
                border-radius: 8px;
                color: var(--bp-ink);
                text-decoration: none;
                font-size: .9rem;
                font-weight: 600;
            }

                .sx-more__menu a:hover {
                    background: rgba(91, 91, 240, .08);
                    color: var(--bp-link);
                }

        .sx-notes-box {
            margin-bottom: var(--bp-gap);
        }

            .sx-notes-box > summary {
                cursor: pointer;
                padding: 10px 16px;
                font-weight: 600;
                font-size: .9rem;
                color: #8A5A00;
            }

            .sx-notes-box ul {
                list-style: none;
                margin: 0;
                padding: 0 16px 14px;
                display: grid;
                gap: 8px;
            }

            .sx-notes-box li {
                display: flex;
                gap: 10px;
                align-items: flex-start;
            }

        .sx-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .9rem;
        }

            .sx-table th {
                text-align: left;
                padding: 10px 8px;
                font-size: .78rem;
                font-weight: 600;
                color: var(--bp-ink-mute);
            }

            .sx-table td {
                padding: 11px 8px;
                border-top: 1px solid var(--bp-line);
                color: var(--bp-ink);
            }

            .sx-table .sx-num {
                text-align: right;
                white-space: nowrap;
            }

            .sx-table tfoot td {
                font-weight: 700;
            }

        .sx-row {
            cursor: pointer;
        }

            .sx-row:hover td {
                background: rgba(91, 91, 240, .05);
            }

        .sx-chev {
            text-align: right;
            color: var(--bp-link);
            width: 32px;
        }

        .sx-row[aria-expanded="true"] .sx-chev {
            transform: rotate(180deg);
        }

        .sx-detail[hidden] {
            display: none;
        }

        .sx-detail td {
            background: rgba(16, 181, 232, .05);
        }

        .sx-tag {
            font-family: var(--bp-font-display);
            font-weight: 600;
            color: var(--bp-link);
        }
    </style>
}
@section Scripts {
    <script src="~/js/workflow-spy.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.querySelectorAll('.sx-row').forEach(function (r) {
                r.addEventListener('click', function () {
                    var d = document.getElementById(r.getAttribute('data-target'));
                    if (!d) return;
                    var open = d.hidden;
                    d.hidden = !open;
                    r.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            });
            document.addEventListener('click', function (e) {
                var m = document.querySelector('.sx-more[open]');
                if (m && !m.contains(e.target)) m.removeAttribute('open');
            });
        })();
    </script>
}

<div class="bp-page-head">
    <div>
        <h1>Detailed results</h1>
        <p class="bp-muted mb-0"><span class="bp-chip bp-chip--simulated">Run v@(Model.Version)</span></p>
    </div>
    <div class="sx-head-actions">
        <details class="sx-more">
            <summary class="bp-btn bp-btn--ghost">More &#9662;</summary>
            <div class="sx-more__menu">
                <a asp-action="Dashboard" asp-route-runId="@Model.SimulationRunId">Dashboard</a>
                <a asp-action="History" asp-route-projectId="@Model.ProjectId">History</a>
                <a asp-controller="Proposal" asp-action="Index" asp-route-runId="@Model.SimulationRunId">Proposal</a>
                <a asp-controller="Layout" asp-action="Editor" asp-route-projectId="@Model.ProjectId">Generate layout</a>
                <a asp-controller="Cad" asp-action="Index" asp-route-runId="@Model.SimulationRunId">PFD drawing</a>
                <a asp-controller="Pid" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-runId="@Model.SimulationRunId">P&amp;ID drawing</a>
            </div>
        </details>
    </div>
</div>

@if (Model.Warnings.Count > 0)
{
    <details class="sx-notes-box sm-warnings bp-card">
        <summary>Engine notes (@Model.Warnings.Count)</summary>
        <ul role="list">
            @foreach (var w in Model.Warnings)
            {
                <li>
                    <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4 3 20h18L12 4zM12 10v4M12 17v.5" /></svg>
                    <span>@w</span>
                </li>
            }
        </ul>
    </details>
}

<div class="sm-columns">
    <section class="sm-panel bp-card" id="sm-massbalance" aria-labelledby="sm-mb-title">
        <h2 class="sm-card-title" id="sm-mb-title">Mass balance and pre-treatment</h2>
        <dl class="sm-bubbles">
            <div class="sm-bubble"><dt>Total feed</dt><dd>@mb.TotalFeedTpd.ToString("N2") <small>TPD</small></dd></div>
            <div class="sm-bubble"><dt>Blended TS</dt><dd>@mb.BlendedTsPercent.ToString("N2") <small>%</small></dd></div>
            <div class="sm-bubble"><dt>Dilution water</dt><dd>@mb.DilutionWaterRequiredTpd.ToString("N2") <small>TPD</small></dd></div>
            <div class="sm-bubble"><dt>Dilution water volume</dt><dd>@mb.DilutionWaterM3Day.ToString("N2") <small>m&sup3;/day</small></dd></div>
            <div class="sm-bubble"><dt>Slurry flow</dt><dd>@mb.TotalSlurryFlowM3Day.ToString("N2") <small>m&sup3;/day</small></dd></div>
            <div class="sm-bubble"><dt>Blended C:N</dt><dd>@mb.BlendedCnRatio.ToString("N2")</dd></div>
            <div class="sm-bubble"><dt>Volatile solids</dt><dd>@mb.VsTotalKgDay.ToString("N0") <small>kg/day</small></dd></div>
            @if (pt.ShredderPowerKw > 0 || pt.MixerPowerKw > 0)
            {
                <div class="sm-bubble"><dt>Shredder capacity</dt><dd>@pt.ShredderCapacityTph.ToString("N1") <small>t/hr</small></dd></div>
                <div class="sm-bubble"><dt>Shredder power</dt><dd>@pt.ShredderPowerKw.ToString("N0") <small>kW</small></dd></div>
                <div class="sm-bubble"><dt>Slurry mix tank</dt><dd>@pt.MixTankVolumeM3.ToString("N0") <small>m&sup3;</small></dd></div>
                <div class="sm-bubble"><dt>Mix tank agitator</dt><dd>@pt.MixerPowerKw.ToString("N0") <small>kW</small></dd></div>
            }
        </dl>
    </section>

    <section class="sm-panel bp-card" id="sm-digester" aria-labelledby="sm-dk-title">
        <h2 class="sm-card-title" id="sm-dk-title">Digester kinetics and gas</h2>
        <dl class="sm-bubbles">
            <div class="sm-bubble"><dt>Retention time</dt><dd>@dk.HrtDays.ToString("N1") <small>days</small></dd></div>
            <div class="sm-bubble"><dt>Loading rate</dt><dd>@dk.OlrKgVsM3Day.ToString("N2") <small>kg VS/m&sup3;/day</small></dd></div>
            <div class="sm-bubble"><dt>Raw biogas</dt><dd>@dk.RawBiogasNm3Day.ToString("N0") <small>Nm&sup3;/day</small></dd></div>
            <div class="sm-bubble"><dt>Net compressed biogas</dt><dd>@dk.NetCbgKgDay.ToString("N0") <small>kg/day</small></dd></div>
            <div class="sm-bubble"><dt>Hydrogen sulfide</dt><dd>@dk.H2sPpm.ToString("N0") <small>ppm</small></dd></div>
        </dl>
        <div class="sm-split" role="img" aria-label="Biogas composition: methane @dk.Ch4Percent.ToString("N1") percent, carbon dioxide @dk.Co2Percent.ToString("N1") percent">
            <span class="sm-split__part sm-split__part--ch4" style="--sm-val:@dk.Ch4Percent.ToString("0.#", inv)">CH&#8324; @dk.Ch4Percent.ToString("N1")%</span>
            <span class="sm-split__part sm-split__part--co2" style="--sm-val:@dk.Co2Percent.ToString("0.#", inv)">CO&#8322; @dk.Co2Percent.ToString("N1")%</span>
            @if (other > 0.5)
            {
                <span class="sm-split__part sm-split__part--rest" style="--sm-val:@other.ToString("0.#", inv)">Other</span>
            }
        </div>
    </section>
</div>

<partial name="_ThermalCard" model="Model.Thermal" />

<partial name="_UpgradingCard" model="Model.Upgrading" />

<partial name="_DigestateCard" model="(Model.Digestate, Model.Dispatch)" />

<section class="sm-section bp-card" aria-labelledby="sm-eq-title">
    <div class="sm-section__head">
        <h2 class="sm-card-title" id="sm-eq-title">Sized equipment</h2>
        <p class="sm-section__total">Equipment total <strong>@totalCost.ToString("N0")</strong></p>
    </div>
    <table class="sx-table">
        <thead>
            <tr>
                <th>Tag</th>
                <th>Equipment</th>
                <th class="sx-num">Qty</th>
                <th class="sx-num">Cost</th>
                <th class="sx-chev"></th>
            </tr>
        </thead>
        <tbody>
            @{
                var idx = 0;
            }
            @foreach (var e in Model.EquipmentSizing)
            {
                idx++;
                var hasDetail = e.GeometryParams.Count > 0 || e.ProcessDuty.Count > 0;
                var detailId = $"sx-detail-{idx}";
                if (hasDetail)
                {
                    <tr class="sx-row" data-target="@detailId" aria-expanded="false">
                        <td class="sx-tag">@e.EquipmentTag</td>
                        <td>@Humanize(e.EquipmentType)</td>
                        <td class="sx-num">@e.Quantity</td>
                        <td class="sx-num">@(e.TotalCost > 0 ? e.TotalCost.ToString("N0") : "Costed in BOM")</td>
                        <td class="sx-chev" aria-hidden="true">&#9662;</td>
                    </tr>
                    <tr class="sx-detail" id="@detailId" hidden>
                        <td colspan="5">
                            @if (e.GeometryParams.Count > 0)
                            {
                                <h4 class="sm-equip__sub">Geometry</h4>
                                <dl class="sm-facts">
                                    @foreach (var g in e.GeometryParams)
                                    {
                                        <div><dt>@KeyLabel(g.Key)</dt><dd>@ValueText(g.Value)</dd></div>
                                    }
                                </dl>
                            }
                            @if (e.ProcessDuty.Count > 0)
                            {
                                <h4 class="sm-equip__sub">Process duty</h4>
                                <dl class="sm-facts">
                                    @foreach (var d in e.ProcessDuty)
                                    {
                                        <div><dt>@KeyLabel(d.Key)</dt><dd>@ValueText(d.Value)</dd></div>
                                    }
                                </dl>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="sx-tag">@e.EquipmentTag</td>
                        <td>@Humanize(e.EquipmentType)</td>
                        <td class="sx-num">@e.Quantity</td>
                        <td class="sx-num">@(e.TotalCost > 0 ? e.TotalCost.ToString("N0") : "Costed in BOM")</td>
                        <td class="sx-chev"></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>