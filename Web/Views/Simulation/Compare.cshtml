@using System.Globalization
@model List<BiogasApp.Model.DTOs.SimulationResultDto>
@{
    var valid = Model != null && Model.Count >= 2;
    var a = valid ? Model![0] : null;
    var b = valid ? Model![1] : null;
    ViewData["Title"] = valid ? $"Compare v{a!.Version} and v{b!.Version}" : "Compare runs";
    ViewData["WorkflowStep"] = 3;
    if (valid)
    {
        ViewData["RunId"] = b!.SimulationRunId;
    }

    var fallbackProjectId = Model?.FirstOrDefault()?.ProjectId ?? Guid.Empty;

    var groups = new List<(string Name, List<(string Label, string Unit, int Digits, double A, double B)> Items)>();
    IReadOnlyList<(string? Heading, IReadOnlyList<string> Items)> noteGroups = new List<(string? Heading, IReadOnlyList<string> Items)>();
    var notesSummary = string.Empty;

    if (valid)
    {
        groups = new List<(string Name, List<(string Label, string Unit, int Digits, double A, double B)> Items)>
        {
            ("Mass balance", new List<(string Label, string Unit, int Digits, double A, double B)>
            {
                ("Total feed", "TPD", 1, a!.MassBalance.TotalFeedTpd, b!.MassBalance.TotalFeedTpd),
                ("Blended TS", "%", 1, a.MassBalance.BlendedTsPercent, b.MassBalance.BlendedTsPercent),
                ("Dilution water", "TPD", 1, a.MassBalance.DilutionWaterRequiredTpd, b.MassBalance.DilutionWaterRequiredTpd),
                ("Slurry flow", "m\u00B3/day", 1, a.MassBalance.TotalSlurryFlowM3Day, b.MassBalance.TotalSlurryFlowM3Day),
                ("Blended C:N", "", 1, a.MassBalance.BlendedCnRatio, b.MassBalance.BlendedCnRatio),
                ("Volatile solids", "kg/day", 0, a.MassBalance.VsTotalKgDay, b.MassBalance.VsTotalKgDay)
            }),
            ("Digester and gas", new List<(string Label, string Unit, int Digits, double A, double B)>
            {
                ("Retention time", "days", 1, a.DigesterKinetics.HrtDays, b.DigesterKinetics.HrtDays),
                ("Loading rate", "kg VS/m\u00B3/day", 2, a.DigesterKinetics.OlrKgVsM3Day, b.DigesterKinetics.OlrKgVsM3Day),
                ("Raw biogas", "Nm\u00B3/day", 0, a.DigesterKinetics.RawBiogasNm3Day, b.DigesterKinetics.RawBiogasNm3Day),
                ("Methane", "%", 1, a.DigesterKinetics.Ch4Percent, b.DigesterKinetics.Ch4Percent),
                ("Carbon dioxide", "%", 1, a.DigesterKinetics.Co2Percent, b.DigesterKinetics.Co2Percent),
                ("Hydrogen sulfide", "ppm", 0, a.DigesterKinetics.H2sPpm, b.DigesterKinetics.H2sPpm),
                ("Net compressed biogas", "kg/day", 0, a.DigesterKinetics.NetCbgKgDay, b.DigesterKinetics.NetCbgKgDay)
            }),
            ("Equipment", new List<(string Label, string Unit, int Digits, double A, double B)>
            {
                ("Equipment total cost", "", 0, (double)a.EquipmentSizing.Sum(e => e.TotalCost), (double)b.EquipmentSizing.Sum(e => e.TotalCost))
            })
        };

        notesSummary = $"Engine notes (A: {a.Warnings.Count}, B: {b.Warnings.Count})";
        noteGroups = new List<(string? Heading, IReadOnlyList<string> Items)>
        {
            ($"Run A (v{a.Version})", a.Warnings),
            ($"Run B (v{b.Version})", b.Warnings)
        };
    }

    var notesModel = (notesSummary, noteGroups);
}
@section Styles {
    <link rel="stylesheet" href="~/css/simulation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
}

<div class="sx-page sx-page--compare">
    @if (!valid)
    {
        <header class="bp-page-head sx-head">
            <div class="sx-head__main">
                <h1 class="sx-head__title">Compare runs</h1>
            </div>
            <div class="sx-head-actions">
                @if (fallbackProjectId != Guid.Empty)
                {
                    <a class="bp-btn bp-btn--ghost" asp-action="History" asp-route-projectId="@fallbackProjectId">Back to history</a>
                }
            </div>
        </header>

        <section class="sm-empty bp-card" aria-live="polite">
            <span class="sm-empty__icon" aria-hidden="true">
                <svg class="bp-ico" viewBox="0 0 24 24" focusable="false"><path d="M4 7h16M4 12h10M4 17h6" /></svg>
            </span>
            <h2>Two runs are needed</h2>
            <p class="bp-muted">Select two simulation runs in the history list to compare them.</p>
        </section>
    }
    else
    {
        <header class="bp-page-head sx-head">
            <div class="sx-head__main">
                <h1 class="sx-head__title">Compare runs</h1>
                <div class="sx-head__chips">
                    <span class="bp-chip bp-chip--simulated">A: v@(a!.Version)</span>
                    <span class="bp-chip bp-chip--approved">B: v@(b!.Version)</span>
                </div>
            </div>
            <div class="sx-head-actions">
                <a class="bp-btn bp-btn--ghost" asp-action="History" asp-route-projectId="@a.ProjectId">Back to history</a>
                <a class="bp-btn bp-btn--ghost" asp-action="Dashboard" asp-route-runId="@a.SimulationRunId">Open A</a>
                <a class="bp-btn bp-btn--ghost" asp-action="Dashboard" asp-route-runId="@b.SimulationRunId">Open B</a>
            </div>
        </header>

        <section class="bp-card sx-card-flush">
            <div class="sx-scroll-box sx-scroll-box--tall">
                <table class="sx-table sx-table--compare">
                    <caption class="visually-hidden">Comparison of run A and run B</caption>
                    <thead>
                        <tr>
                            <th scope="col">Measure</th>
                            <th scope="col" class="sx-num">A (v@(a.Version))</th>
                            <th scope="col" class="sx-num">B (v@(b.Version))</th>
                            <th scope="col" class="sx-num">Change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in groups)
                        {
                            <tr class="sx-group"><th scope="rowgroup" colspan="4">@g.Name</th></tr>
                            foreach (var m in g.Items)
                            {
                                var delta = m.B - m.A;
                                var pct = Math.Abs(m.A) > 0.0000001 ? delta / Math.Abs(m.A) * 100d : (double?)null;
                                var fmt = "N" + m.Digits;
                                var state = Math.Abs(delta) < 0.0000001 ? "same" : delta > 0 ? "up" : "down";
                                <tr>
                                    <td>@m.Label@(string.IsNullOrEmpty(m.Unit) ? string.Empty : " (" + m.Unit + ")")</td>
                                    <td class="sx-num">@m.A.ToString(fmt)</td>
                                    <td class="sx-num"><strong>@m.B.ToString(fmt)</strong></td>
                                    <td class="sx-num">
                                        @if (state == "up")
                                        {
                                            <span class="sx-up">&#9650; @delta.ToString(fmt)@(pct.HasValue ? " (+" + pct.Value.ToString("N1") + "%)" : string.Empty)</span>
                                        }
                                        else if (state == "down")
                                        {
                                            <span class="sx-down">&#9660; @Math.Abs(delta).ToString(fmt)@(pct.HasValue ? " (" + pct.Value.ToString("N1") + "%)" : string.Empty)</span>
                                        }
                                        else
                                        {
                                            <span class="sx-same">No change</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <partial name="_EngineNotes" model="notesModel" />
    }
</div>