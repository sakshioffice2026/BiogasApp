@using System.Globalization
@using Web.Helpers
@model BiogasApp.Model.ViewModel.SimulationDashboardViewModel
@{
    ViewData["Title"] = $"Simulation v{Model.RunVersion}";
    ViewData["RunId"] = Model.SimulationRunId;
    ViewData["WorkflowStep"] = 3;
    var inv = CultureInfo.InvariantCulture;
    var mb = Model.MassBalance;
    var dk = Model.DigesterKinetics;
    var pt = Model.PreTreatment;
    var warnings = Model.Warnings.Count > 0 ? Model.Warnings : Model.Kpis.Warnings;
    var other = Math.Max(0d, 100d - dk.Ch4Percent - dk.Co2Percent);
    var showTech = Model.Kpis.TechnologyComparison.Count > 1;

    var headerModel = ("Simulation results", Model.ProjectName, Model.RunVersion, Model.ProjectStatus.Css(), Model.ProjectStatus.Label(), Model.ProjectId, Model.SimulationRunId, "Dashboard");
    var notesModel = ($"Engine notes ({warnings.Count})",
        (IReadOnlyList<(string? Heading, IReadOnlyList<string> Items)>)new List<(string? Heading, IReadOnlyList<string> Items)> { (null, warnings) });
    var equipmentModel = ((IReadOnlyList<BiogasApp.Model.DTOs.EquipmentSizingDto>)Model.Equipment, false, "dash");
    var digestateModel = (Model.Digestate, Model.Dispatch);
}
@section Styles {
    <link rel="stylesheet" href="~/css/simulation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
}

<div class="sx-page sx-page--dash">
    <partial name="_SimulationHeader" model="headerModel" />

    @if (warnings.Count > 0)
    {
        <partial name="_EngineNotes" model="notesModel" />
    }

    <partial name="_KpiCards" model="Model.Kpis" />

    <div class="sx-grid">
        <section class="sm-panel bp-card" id="sm-massbalance" aria-labelledby="sm-mb-title">
            <h2 class="sm-card-title" id="sm-mb-title">Mass balance and pre-treatment</h2>
            <dl class="sx-metrics">
                <div class="sx-metric"><dt>Total feed</dt><dd>@mb.TotalFeedTpd.ToString("N1") <small>TPD</small></dd></div>
                <div class="sx-metric"><dt>Blended TS</dt><dd>@mb.BlendedTsPercent.ToString("N1") <small>%</small></dd></div>
                <div class="sx-metric"><dt>Slurry flow</dt><dd>@mb.TotalSlurryFlowM3Day.ToString("N1") <small>m&sup3;/day</small></dd></div>
                <div class="sx-metric"><dt>Blended C:N</dt><dd>@mb.BlendedCnRatio.ToString("N1")</dd></div>
            </dl>
            <dl class="sx-spec">
                <div><dt>Dilution water</dt><dd>@mb.DilutionWaterRequiredTpd.ToString("N1") TPD</dd></div>
                <div><dt>Volatile solids</dt><dd>@mb.VsTotalKgDay.ToString("N0") kg/day</dd></div>
                @if (pt.ShredderPowerKw > 0 || pt.MixerPowerKw > 0)
                {
                    <div><dt>Shredder capacity</dt><dd>@pt.ShredderCapacityTph.ToString("N1") t/h</dd></div>
                    <div><dt>Shredder power</dt><dd>@pt.ShredderPowerKw.ToString("N0") kW</dd></div>
                    <div><dt>Slurry mix tank</dt><dd>@pt.MixTankVolumeM3.ToString("N0") m&sup3;</dd></div>
                    <div><dt>Mix tank agitator</dt><dd>@pt.MixerPowerKw.ToString("N0") kW</dd></div>
                }
            </dl>
        </section>

        <section class="sm-panel bp-card" id="sm-digester" aria-labelledby="sm-dk-title">
            <h2 class="sm-card-title" id="sm-dk-title">Digester performance</h2>
            <dl class="sx-metrics">
                <div class="sx-metric"><dt>Retention time</dt><dd>@dk.HrtDays.ToString("N1") <small>days</small></dd></div>
                <div class="sx-metric"><dt>Loading rate</dt><dd>@dk.OlrKgVsM3Day.ToString("N2") <small>kg VS/m&sup3;/day</small></dd></div>
                <div class="sx-metric"><dt>Hydrogen sulfide</dt><dd>@dk.H2sPpm.ToString("N0") <small>ppm</small></dd></div>
            </dl>
            <div class="sm-split" role="img" aria-label="Biogas composition: methane @dk.Ch4Percent.ToString("N1") percent, carbon dioxide @dk.Co2Percent.ToString("N1") percent">
                <span class="sm-split__part sm-split__part--ch4" style="--sm-val:@dk.Ch4Percent.ToString("0.#", inv)">CH&#8324; @dk.Ch4Percent.ToString("N1")%</span>
                <span class="sm-split__part sm-split__part--co2" style="--sm-val:@dk.Co2Percent.ToString("0.#", inv)">CO&#8322; @dk.Co2Percent.ToString("N1")%</span>
                @if (other > 0.5)
                {
                    <span class="sm-split__part sm-split__part--rest" style="--sm-val:@other.ToString("0.#", inv)">Other</span>
                }
            </div>
        </section>

        <partial name="_ThermalCard" model="Model.Thermal" />

        <div class="sx-stack">
            <partial name="_UpgradingCard" model="Model.Upgrading" />
            @if (showTech)
            {
                <div class="sm-panel bp-card sx-tech-card">
                    <partial name="_TechToggle" model="Model" />
                </div>
            }
        </div>

        <partial name="_DigestateCard" model="digestateModel" />

        <section class="sm-panel bp-card" id="sm-equipment" aria-labelledby="sm-eq-title">
            <div class="sm-section__head">
                <h2 class="sm-card-title" id="sm-eq-title">Sized equipment</h2>
                <a class="bp-btn bp-btn--ghost" asp-action="Results" asp-route-runId="@Model.SimulationRunId" asp-fragment="sm-equipment">Full details</a>
            </div>
            <div class="sx-scroll-box">
                <partial name="_EquipmentTable" model="equipmentModel" />
            </div>
        </section>
    </div>
</div>
