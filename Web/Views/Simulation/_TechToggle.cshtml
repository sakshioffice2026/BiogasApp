@using BiogasApp.Database.Enums
@using Web.Helpers
@model BiogasApp.Model.ViewModel.SimulationDashboardViewModel
@{
    var options = Model.Kpis.TechnologyComparison;
    var selectedKey = Model.SelectedTechnology.ToString().ToUpperInvariant();
    var bestYield = options.Count > 0 ? options.Max(o => o.NetCbgKgDay) : 0d;
    var lowestPower = options.Count > 0 ? options.Min(o => o.UpgradingPowerKw + o.CompressorPowerKw) : 0d;
}

@if (options.Count > 1)
{
    <section class="sm-tech" aria-labelledby="sm-tech-title">
        <h3 class="sm-sub-title" id="sm-tech-title">Upgrading technology</h3>
        <div class="sx-table-wrap">
            <table class="sx-table sx-table--tech">
                <thead>
                    <tr>
                        <th scope="col">Technology</th>
                        <th scope="col" class="sx-num">Recovery</th>
                        <th scope="col" class="sx-num">Purity</th>
                        <th scope="col" class="sx-num">Power</th>
                        <th scope="col" class="sx-num">Net output</th>
                        <th scope="col" class="sx-num"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in options)
                    {
                        var parsed = Enum.TryParse<UpgradingTech>(t.Technology, true, out var tech);
                        var isSelected = string.Equals(t.Technology, selectedKey, StringComparison.OrdinalIgnoreCase);
                        var power = t.UpgradingPowerKw + t.CompressorPowerKw;
                        <tr class="@(isSelected ? "is-selected" : null)">
                            <th scope="row" class="sx-tech-name">
                                @(parsed ? tech.Label() : t.Technology)
                                @if (t.NetCbgKgDay >= bestYield)
                                {
                                    <span class="bp-chip bp-chip--simulated">Highest yield</span>
                                }
                                @if (power <= lowestPower)
                                {
                                    <span class="bp-chip bp-chip--archived">Lowest power</span>
                                }
                            </th>
                            <td class="sx-num">@t.RecoveryPercent.ToString("N1")%</td>
                            <td class="sx-num">@t.PurityPercent.ToString("N1")%</td>
                            <td class="sx-num">@power.ToString("N0") kW</td>
                            <td class="sx-num">@t.NetCbgKgDay.ToString("N0") kg/day</td>
                            <td class="sx-num">
                                @if (isSelected)
                                {
                                    <span class="bp-chip bp-chip--approved" aria-current="true">Selected</span>
                                }
                                else
                                {
                                    <a class="bp-btn bp-btn--ghost"
                                       asp-action="Dashboard" asp-route-runId="@Model.SimulationRunId" asp-route-tech="@(parsed ? tech.ToString() : t.Technology)">Select</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
