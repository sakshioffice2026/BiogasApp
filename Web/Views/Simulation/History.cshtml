@using System.Text.Json
@model List<BiogasApp.Database.Entities.SimulationRun>
@{
    var projectId = ViewData["ProjectId"] as Guid? ?? Guid.Empty;
    var projectName = ViewData["ProjectName"] as string ?? string.Empty;
    ViewData["Title"] = "Simulation history";
    ViewData["WorkflowStep"] = 3;
    var count = Model.Count;
    var latestId = count > 0 ? Model[0].Id : Guid.Empty;
    if (count > 0)
    {
        ViewData["RunId"] = latestId;
    }
}
@functions {
    static int WarningCount(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return 0;
        try
        {
            return JsonSerializer.Deserialize<List<string>>(json)?.Count ?? 0;
        }
        catch (JsonException)
        {
            return 0;
        }
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/simulation.css" asp-append-version="true" />
    <style>
        .sx-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .9rem;
        }

            .sx-table th {
                text-align: left;
                padding: 10px 8px;
                font-size: .78rem;
                font-weight: 600;
                color: var(--bp-ink-mute);
                white-space: nowrap;
            }

            .sx-table td {
                padding: 12px 8px;
                border-top: 1px solid var(--bp-line);
                color: var(--bp-ink);
                vertical-align: middle;
            }

            .sx-table .sx-num {
                text-align: right;
                white-space: nowrap;
            }

            .sx-table tbody tr:hover td {
                background: rgba(91, 91, 240, .05);
            }

            .sx-table tr.is-picked td {
                background: rgba(16, 181, 232, .08);
            }

        .sx-run {
            font-family: var(--bp-font-display);
            font-weight: 600;
            color: var(--bp-link);
            white-space: nowrap;
        }

        .sx-date {
            font-size: .8rem;
            color: var(--bp-ink-mute);
            white-space: nowrap;
        }

        .sx-links {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
            white-space: nowrap;
        }

            .sx-links a {
                padding: 6px 12px;
                border-radius: 999px;
                border: 1px solid var(--bp-line);
                background: #fff;
                color: var(--bp-ink);
                text-decoration: none;
                font-size: .82rem;
                font-weight: 600;
            }

                .sx-links a:hover {
                    color: var(--bp-link);
                    box-shadow: var(--bp-shadow);
                }

        .sx-cmpbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: var(--bp-gap);
            padding: 10px 16px;
        }

        .sx-scroll {
            overflow-x: auto;
        }

        .sx-pick input {
            width: 18px;
            height: 18px;
            accent-color: var(--bp-indigo);
        }
    </style>
}
@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('[data-sm-compare]');
            if (!form) return;
            var boxes = form.querySelectorAll('.sx-pick input');
            var btn = form.querySelector('[data-sx-compare]');
            var note = form.querySelector('[data-sx-note]');
            var a = form.querySelector('[name="runA"]');
            var b = form.querySelector('[name="runB"]');
            function sync() {
                var checked = Array.prototype.filter.call(boxes, function (x) { return x.checked; });
                boxes.forEach(function (x) {
                    x.closest('tr').classList.toggle('is-picked', x.checked);
                    x.disabled = !x.checked && checked.length >= 2;
                });
                if (btn) btn.disabled = checked.length !== 2;
                if (note) note.textContent = checked.length + ' of 2 runs selected';
                a.value = checked.length > 0 ? checked[0].value : '';
                b.value = checked.length > 1 ? checked[1].value : '';
            }
            boxes.forEach(function (x) { x.addEventListener('change', sync); });
            sync();
        })();
    </script>
}

<div class="bp-page-head">
    <div>
        <h1>Simulation history</h1>
        <p class="bp-muted mb-0">
            <strong>@projectName</strong> has @count @(count == 1 ? "run" : "runs")
        </p>
    </div>
    <div class="sm-actions">
        <a class="bp-btn bp-btn--flame" asp-action="Mixer" asp-route-projectId="@projectId">New run</a>
        <a class="bp-btn bp-btn--ghost" asp-controller="Project" asp-action="Detail" asp-route-id="@projectId">Back to project</a>
    </div>
</div>

@if (count == 0)
{
    <section class="sm-empty bp-card" aria-live="polite">
        <span class="sm-empty__icon" aria-hidden="true">
            <svg class="bp-ico" viewBox="0 0 24 24" focusable="false"><path d="m8 5 11 7-11 7V5z" /></svg>
        </span>
        <h2>No simulations yet</h2>
        <p class="bp-muted">Blend your feedstock and run the first simulation for this plant.</p>
        <a class="bp-btn bp-btn--flame" asp-action="Mixer" asp-route-projectId="@projectId">Open the mixer</a>
    </section>
}
else
{
    <form method="get" asp-action="Compare" class="sm-history" data-sm-compare>
        <input type="hidden" name="runA" value="" />
        <input type="hidden" name="runB" value="" />

        @if (count > 1)
        {
            <div class="sx-cmpbar bp-card">
                <p class="mb-0 bp-muted" data-sx-note aria-live="polite">0 of 2 runs selected</p>
                <button type="submit" class="bp-btn bp-btn--primary" data-sx-compare disabled>Compare</button>
            </div>
        }

        <section class="bp-card sx-scroll">
            <table class="sx-table">
                <thead>
                    <tr>
                        @if (count > 1)
                        {
                            <th><span class="visually-hidden">Select</span></th>
                        }
                        <th>Run</th>
                        <th>Date</th>
                        <th class="sx-num">Feed (TPD)</th>
                        <th class="sx-num">Raw biogas (Nm&sup3;/day)</th>
                        <th class="sx-num">Net (kg/day)</th>
                        <th class="sx-num">C:N</th>
                        <th class="sx-num">Retention (days)</th>
                        <th class="sx-num">Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model)
                    {
                        var warns = WarningCount(run.WarningsJson);
                        <tr>
                            @if (count > 1)
                            {
                                <td>
                                    <label class="sx-pick">
                                        <input type="checkbox" value="@run.Id" aria-label="Select run v@(run.RunVersion) to compare" />
                                    </label>
                                </td>
                            }
                            <td class="sx-run">
                                v@(run.RunVersion)
                                @if (run.Id == latestId)
                                {
                                    <span class="bp-chip bp-chip--approved">Latest</span>
                                }
                            </td>
                            <td class="sx-date"><time datetime="@run.CreatedAt.ToString("o")">@run.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</time></td>
                            <td class="sx-num">@run.TotalFeedTpd.ToString("N1")</td>
                            <td class="sx-num">@run.RawBiogasNm3Day.ToString("N0")</td>
                            <td class="sx-num">@run.NetCbgKgDay.ToString("N0")</td>
                            <td class="sx-num">@run.BlendedCnRatio.ToString("N1")</td>
                            <td class="sx-num">@run.HrtDays.ToString("N1")</td>
                            <td class="sx-num">
                                @if (warns > 0)
                                {
                                    <span class="bp-chip bp-chip--archived">@warns</span>
                                }
                                else
                                {
                                    <span class="bp-muted">0</span>
                                }
                            </td>
                            <td>
                                <div class="sx-links">
                                    <a asp-action="Dashboard" asp-route-runId="@run.Id">Dashboard</a>
                                    <a asp-action="Results" asp-route-runId="@run.Id">Full results</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </form>
}