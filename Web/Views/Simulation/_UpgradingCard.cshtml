@model BiogasApp.Model.DTOs.UpgradingDto

<section class="sm-panel bp-card" id="sm-upgrading" aria-labelledby="sm-up-title">
    <h2 class="sm-card-title" id="sm-up-title">Upgrading and compression</h2>

    @if (Model.CbgKgDay <= 0 && Model.UpgradingPowerKw <= 0)
    {
        <p class="bp-muted mb-0">Not available for this run. Run the simulation again to see these results.</p>
    }
    else
    {
        <dl class="sx-metrics">
            <div class="sx-metric"><dt>Technology</dt><dd>@Model.Technology</dd></div>
            <div class="sx-metric"><dt>Compressed biogas mass</dt><dd>@Model.CbgKgDay.ToString("N0") <small>kg/day</small></dd></div>
            <div class="sx-metric"><dt>Upgrading power</dt><dd>@Model.UpgradingPowerKw.ToString("N1") <small>kW</small></dd></div>
            <div class="sx-metric"><dt>Compressor power</dt><dd>@Model.CompressorPowerKw.ToString("N1") <small>kW</small></dd></div>
        </dl>

        <h3 class="sx-spec-title">Upgrading detail</h3>
        <dl class="sx-spec">
            <div><dt>Compressed biogas</dt><dd>@Model.CbgNm3Day.ToString("N0") Nm&sup3;/day</dd></div>
            <div><dt>Compressor capacity</dt><dd>@Model.CompressorCapacityNm3Hr.ToString("N0") Nm&sup3;/h</dd></div>
            <div><dt>Cascade water capacity</dt><dd>@Model.CascadeWaterCapacityLiters.ToString("N0") L</dd></div>
            <div><dt>Cascade banks (3,000 L)</dt><dd>@Model.CascadeBanks3000L</dd></div>
        </dl>
    }
</section>
