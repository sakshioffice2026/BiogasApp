@using System.Security.Claims
@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("ClientAdmin");

    var runId = ViewData["RunId"] as Guid?;

    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "User";
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var initials = parts.Length == 0
        ? "U"
        : (parts.Length == 1
            ? parts[0].Substring(0, 1)
            : parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpperInvariant();

    var roleLabel = (User.FindFirstValue(ClaimTypes.Role) ?? string.Empty) switch
    {
        "SuperAdmin" => "Platform admin",
        "ClientAdmin" => "Client admin",
        var r => r
    };

    string Active(params string[] names) =>
        Array.IndexOf(names, ctrl) >= 0 ? "is-active" : string.Empty;

    string Current(params string[] names) =>
        Array.IndexOf(names, ctrl) >= 0 ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EEF7FF" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>@ViewData["Title"] - BiogasApp</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/simulation-theme.css" asp-append-version="true" />
</head>

<body class="@(isAuth ? "bp-has-rail" : "bp-guest")">

    <a class="bp-skip" href="#main">Skip to content</a>
    <div class="bp-aurora" aria-hidden="true"></div>

    <!-- ================= TOP NAVBAR ================= -->
    <header class="bp-topbar bp-glass">

        <a class="bp-brand"
           asp-controller="@(isAuth ? "Dashboard" : "Home")"
           asp-action="Index"
           aria-label="BiogasApp home">

            <!-- Biogas Logo -->
            <svg class="bp-brand__mark"
                 viewBox="0 0 48 48"
                 aria-hidden="true"
                 focusable="false">

                <defs>
                    <linearGradient id="bioLogo" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#0D9488" />
                        <stop offset="100%" stop-color="#2563EB" />
                    </linearGradient>
                </defs>

                <rect width="48" height="48" rx="14" fill="url(#bioLogo)" />

                <!-- Flame-leaf (green energy) -->
                <path d="M24 5C17 13 15 18.5 18 23.5C19.5 26 28.5 26 30 23.5C33 18.5 31 13 24 5Z"
                      fill="#B9F5C8" />
                <path d="M24 13C21 17 20.5 20.5 22 22.5C23 23.8 25 23.8 26 22.5C27.5 20.5 27 17 24 13Z"
                      fill="#FFB347" />
                <path d="M24 9V15"
                      stroke="#0D9488"
                      stroke-width="1.2"
                      stroke-linecap="round" />

                <!-- Gas connector -->
                <rect x="22.8" y="25.5" width="2.4" height="4" rx="1" fill="#FFFFFF" />

                <!-- Digester tank -->
                <rect x="9" y="29" width="30" height="13" rx="4"
                      fill="#FFFFFF" opacity=".96" />

                <!-- Slurry wave -->
                <path d="M13 36c3-2.4 5 2.4 8 0s5-2.4 8 0 4 1.6 6 0"
                      stroke="#0D9488"
                      stroke-width="1.8"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>

            <span class="bp-brand__name">Biogas<em>App</em></span>
        </a>

        @if (isAuth)
        {
            <!-- USER PROFILE -->
            <div class="dropdown">

                <button class="bp-user"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Account menu for @fullName">

                    <span class="bp-user__avatar" aria-hidden="true">@initials</span>

                    <span class="bp-user__meta">
                        <span class="bp-user__name">@fullName</span>
                        <span class="bp-user__role">@roleLabel</span>
                    </span>

                    <svg class="bp-ico bp-user__caret"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                <ul class="dropdown-menu dropdown-menu-end bp-menu">

                    <li>
                        <a class="dropdown-item"
                           asp-controller="Account"
                           asp-action="Profile">
                            My profile
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           asp-controller="Account"
                           asp-action="ChangePassword">
                            Change password
                        </a>
                    </li>

                    <li><hr class="dropdown-divider" /></li>

                    <li>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit" class="dropdown-item">
                                Sign out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <!-- GUEST ACTIONS -->
            <div class="bp-topbar__actions">
                <a class="bp-btn bp-btn--ghost"
                   asp-controller="Account"
                   asp-action="Login">
                    Sign in
                </a>

                <a class="bp-btn bp-btn--primary"
                   asp-controller="Account"
                   asp-action="Register">
                    Create account
                </a>
            </div>
        }
    </header>

    <!-- ================= SIDEBAR ================= -->
    @if (isAuth)
    {
        <nav class="bp-rail bp-glass" aria-label="Main navigation">

            <ul class="bp-rail__list" role="list">

                @if (isAdmin)
                {
                    <!-- Enquiries -->
                    <li>
                        <a class="bp-node @Active("enquiry")"
                           asp-controller="Enquiry"
                           asp-action="Index"
                           aria-current="@Current("enquiry")">

                            <span class="bp-node__dot">
                                <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 5h16v11H8l-4 4V5Z" />
                                    <path d="M8 9h8M8 12h5" />
                                </svg>
                            </span>

                            <span class="bp-node__label">Enquiries</span>
                        </a>
                    </li>
                }

                <!-- Site assessments -->
                <li>
                    <a class="bp-node @Active("assessment")"
                       asp-controller="Assessment"
                       asp-action="Index"
                       aria-current="@Current("assessment")">

                        <span class="bp-node__dot">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                        </span>

                        <span class="bp-node__label">Site assessments</span>
                    </a>
                </li>

                <!-- Projects -->
                <li>
                    <a class="bp-node @Active("project")"
                       asp-controller="Project"
                       asp-action="Index"
                       aria-current="@Current("project")">

                        <span class="bp-node__dot">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m3 7 9-4 9 4-9 5-9-5Z" />
                                <path d="m3 12 9 5 9-5" />
                                <path d="m3 17 9 5 9-5" />
                            </svg>
                        </span>

                        <span class="bp-node__label">Projects</span>
                    </a>
                </li>

                <!-- Drawings -->
                <li>
                    <a class="bp-node @Active("cad")"
                       asp-controller="Cad"
                       asp-action="Projects"
                       aria-current="@Current("cad")">

                        <span class="bp-node__dot">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="16" rx="2" />
                                <path d="M7 15l3-4 3 3 4-6" />
                            </svg>
                        </span>

                        <span class="bp-node__label">Drawings</span>
                    </a>
                </li>

                <!-- Datasheets -->
                <li>
                    <a class="bp-node @(ctrl == "pid" && (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).StartsWith("Datasheet", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                       asp-controller="Pid"
                       asp-action="DatasheetProjects">

                        <span class="bp-node__dot">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 3h9l4 4v14H6Z" />
                                <path d="M14 3v5h5" />
                                <path d="M9 13h7" />
                                <path d="M9 17h7" />
                            </svg>
                        </span>

                        <span class="bp-node__label">Datasheets</span>
                    </a>
                </li>

                <!-- Feedstock -->
                <li>
                    <a class="bp-node @Active("feedstock")"
                       asp-controller="Feedstock"
                       asp-action="Index"
                       aria-current="@Current("feedstock")">

                        <span class="bp-node__dot">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 4C10 4 5 9 5 19" />
                                <path d="M5 19c0-7 5-12 15-15" />
                                <path d="M5 19c4-4 7-7 11-9" />
                                <path d="M12 14c0 3-2 5-5 5" />
                            </svg>
                        </span>

                        <span class="bp-node__label">Feedstock</span>
                    </a>
                </li>

                @if (isAdmin)
                {
                    <!-- Admin -->
                    <li>
                        <a class="bp-node @Active("admin")"
                           asp-controller="Admin"
                           asp-action="Index"
                           aria-current="@Current("admin")">

                            <span class="bp-node__dot">
                                <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                            </span>

                            <span class="bp-node__label">Admin</span>
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

    <!-- ================= MAIN CONTENT ================= -->
    <main id="main" class="bp-main" tabindex="-1">
        <div class="bp-main__inner">

            <!-- Notifications -->
            @if (TempData["Success"] != null || TempData["Error"] != null)
            {
                <div class="bp-flash">

                    @if (TempData["Success"] is string ok)
                    {
                        <div class="bp-toast bp-toast--success alert fade show"
                             role="status"
                             data-bp-autohide>

                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 3 3 5-6" />
                            </svg>

                            <span class="bp-toast__text">@ok</span>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Dismiss message"></button>
                        </div>
                    }

                    @if (TempData["Error"] is string err)
                    {
                        <div class="bp-toast bp-toast--error alert fade show"
                             role="alert">

                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3 2.5 20h19L12 3z" />
                                <path d="M12 10v4M12 17.2v.1" />
                            </svg>

                            <span class="bp-toast__text">@err</span>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Dismiss message"></button>
                        </div>
                    }

                </div>
            }

            @if (ViewData["WorkflowStep"] is int wfStep)
            {
                <partial name="_NextStepBar" />
                <div class="wf-layout" data-wf-page="@(ViewContext.RouteData.Values["controller"])/@(ViewContext.RouteData.Values["action"])">
                    <partial name="~/Views/Project/_WorkflowTimeline.cshtml" model="wfStep" />
                    <div class="wf-content">
                        @RenderBody()
                    </div>
                </div>
            }
            else
            {
                @RenderBody()
            }

            <!-- Footer -->
            <footer class="bp-footer">
                <span>&copy; @DateTime.Now.Year BiogasApp</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>

        </div>
    </main>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sim-wizard.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>