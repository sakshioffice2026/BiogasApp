@model IEnumerable<KeyValuePair<string, string?>>
@{
    var items = Model?.ToList() ?? new List<KeyValuePair<string, string?>>();
}

@if (items.Count > 0)
{
    <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                var isLast = i == items.Count - 1;

                if (isLast || string.IsNullOrWhiteSpace(item.Value))
                {
                    <li class="breadcrumb-item active" aria-current="@(isLast ? "page" : null)">@item.Key</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@item.Value">@item.Key</a></li>
                }
            }
        </ol>
    </nav>
}
