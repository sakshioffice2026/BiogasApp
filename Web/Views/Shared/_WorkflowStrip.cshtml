@model int
@functions {
    static readonly (string Design, string Plant)[] Steps =
    {
        ("Site and feedstock", "Sourcing"),
        ("Blending, water", "Pre-treatment"),
        ("Digester, gas", "Digestion"),
        ("Thermal, mixing", "Heat, cleaning"),
        ("Upgrading", "250-bar CBG"),
        ("Digestate, civils", "Dispatch"),
        ("CAD, BOM, proposal", "Deliverables")
    };

    // Section ids on the simulation Dashboard and Results pages, indexed by step number (1 based).
    static readonly string?[] Anchors =
    {
        null,
        "sm-massbalance",
        "sm-digester",
        "sm-thermal",
        "sm-upgrading",
        "sm-digestate",
        null
    };
}
@{
    var current = Math.Clamp(Model, 1, Steps.Length);

    // Results pages set ViewData["RunId"]; only those pages contain the section anchors.
    var linkSections = ViewData["RunId"] != null;
}

<nav class="wfs" aria-label="Project workflow">
    <ol class="wfs__list" role="list">
        @for (var i = 1; i <= Steps.Length; i++)
        {
            var s = Steps[i - 1];
            var state = i < current ? "is-done" : i == current ? "is-current" : "is-upcoming";
            var anchor = linkSections ? Anchors[i - 1] : null;
            <li class="wfs__item @state" aria-current="@(i == current ? "step" : null)" title="@s.Design | @s.Plant">
                <span class="wfs__dot">
                    @if (i < current)
                    {
                        <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12l5 5 9-10" /></svg>
                        <span class="visually-hidden">Completed: </span>
                    }
                    else
                    {
                        @i
                    }
                </span>
                @if (anchor != null)
                {
                    <a class="wfs__txt wfs__link" href="#@anchor">
                        <strong>@s.Design</strong>
                        <small>@s.Plant</small>
                    </a>
                }
                else
                {
                    <span class="wfs__txt">
                        <strong>@s.Design</strong>
                        <small>@s.Plant</small>
                    </span>
                }
            </li>
        }
    </ol>
</nav>