@model BiogasApp.Model.ViewModel.ProjectIndexViewModel
@using BiogasApp.Model.DTOs
@{
    ViewData["Title"] = "Datasheets";
    var drawings = ViewData["Drawings"] as Dictionary<Guid, List<PidDiagramDto>> ?? new Dictionary<Guid, List<PidDiagramDto>>();
}

@section Styles {
    <style>
        .ds-badge {
            background: #FFF1C9;
            color: #7A4B00;
            border: 1px solid #FFD27A;
            font-size: .75rem;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 999px;
            letter-spacing: .3px;
        }

        .ds-proj-name {
            font-family: var(--bp-font-display);
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--bp-ink);
        }

        .ds-drawing-no {
            display: inline-block;
            min-width: 66px;
            text-align: center;
            padding: 3px 8px;
            border-radius: 7px;
            background: var(--bp-tint);
            color: var(--bp-ink);
            font-family: var(--bp-font-display);
            font-size: .85rem;
            font-weight: 700;
            margin-right: 8px;
        }

        .ds-drawing-row {
            border-top: 1px solid var(--bp-row-line);
        }

            .ds-drawing-row:hover {
                background: var(--bp-tint-2);
            }
    </style>
}

<div class="mb-3">
    <h1 class="mb-0">Datasheets</h1>
    <div class="text-muted">Equipment datasheets for each P&amp;ID</div>
</div>

<div class="card">
    <div class="card-header">Projects</div>
    <div class="list-group list-group-flush">
        @if (Model.Projects.Count == 0)
        {
            <div class="list-group-item text-muted">No projects yet.</div>
        }
        @foreach (var p in Model.Projects)
        {
            drawings.TryGetValue(p.Id, out var list);
            list ??= new List<PidDiagramDto>();

            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="ds-proj-name">@p.Name</div>
                        <div class="small text-muted">@p.LocationCountry, @p.Status, @p.RunCount run(s)</div>
                    </div>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Pid" asp-action="Index" asp-route-projectId="@p.Id">P&amp;ID</a>
                </div>

                @if (list.Count == 0)
                {
                    <div class="small text-muted">No P&amp;ID yet. Generate one from the P&amp;ID page.</div>
                }
                else
                {
                    @foreach (var d in list.OrderByDescending(x => x.RevisionNo))
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center ds-drawing-row py-2 px-2">
                            <div class="d-flex align-items-center gap-2">
                                <span><span class="ds-drawing-no">@d.DrawingNo</span>@d.Title</span>
                                <span class="small text-muted">Rev @d.RevisionNo</span>
                                <span class="ds-badge">@d.Status</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-primary"
                                   asp-controller="Pid" asp-action="DatasheetPage" asp-route-id="@d.Id">Open datasheets</a>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Pid" asp-action="ExportDatasheetExcel" asp-route-id="@d.Id">Excel</a>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>