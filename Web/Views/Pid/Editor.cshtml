@model BiogasApp.Model.ViewModel.PidEditorViewModel
@using BiogasApp.Database.Enums
@{
    ViewData["Title"] = "P&ID editor";
    var statuses = Enum.GetNames(typeof(PidApprovalStatus));
}

@section Styles {
    <style>
        #pidCanvas {
            height: 70vh;
            min-height: 420px;
            border: 1px solid var(--bs-border-color, #dee2e6);
            border-radius: .375rem;
            background: var(--bs-body-bg, #fff);
            overflow: hidden;
        }

            #pidCanvas .pid-node,
            #pidCanvas .pid-valve,
            #pidCanvas .pid-instrument,
            #pidCanvas .pid-line {
                cursor: pointer;
            }

        #pidEditor.is-busy {
            opacity: .7;
            pointer-events: none;
        }

        #pidLegend {
            max-height: 40vh;
            overflow-y: auto;
        }

        #pidProps {
            max-height: 40vh;
            overflow-y: auto;
        }
    </style>
}

<div id="pidEditor"
     data-diagram-id="@Model.PidDiagramId"
     data-readonly="@(Model.IsReadOnly ? "true" : "false")"
     data-data-url="@Url.Action("Data", "Pid")"
     data-save-url="@Url.Action("Save", "Pid")"
     data-status-url="@Url.Action("SetStatus", "Pid")"
     data-revision-url="@Url.Action("NewRevision", "Pid")">

    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
        <div>
            <h1 class="h4 mb-0">P&amp;ID editor</h1>
            <div class="text-muted">
                @Model.ProjectName -
                <span id="drawingNoText">@Model.Diagram.DrawingNo</span>
                <span id="revisionText">Rev @Model.Diagram.RevisionNo</span>
                <span id="statusBadge" class="badge text-bg-secondary">@Model.Diagram.Status</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-controller="Pid"
               asp-route-projectId="@Model.ProjectId" asp-route-runId="@Model.SimulationRunId">Back</a>
            <a class="btn btn-outline-primary btn-sm" asp-action="ExportExcel" asp-controller="Pid"
               asp-route-id="@Model.PidDiagramId">Download lists (Excel)</a>
        </div>
    </div>

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-info py-2 small">
            This drawing is approved and read-only. Start a new revision to edit it.
        </div>
    }

    <div id="pidMessage" class="d-none"></div>

    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <button type="button" class="btn btn-success btn-sm" id="btnSave" disabled>Save</button>

        <div class="btn-group btn-group-sm" role="group" aria-label="Undo and redo">
            <button type="button" class="btn btn-outline-secondary" id="btnUndo" title="Undo (Ctrl+Z)" disabled>Undo</button>
            <button type="button" class="btn btn-outline-secondary" id="btnRedo" title="Redo (Ctrl+Y)" disabled>Redo</button>
        </div>

        <div class="vr"></div>

        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnConnect" title="Draw a pipe between two equipment items">Connect</button>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnDelete" title="Delete selected (Delete key)" disabled>Delete</button>

        <div class="vr"></div>

        <div class="btn-group btn-group-sm" role="group" aria-label="Zoom">
            <button type="button" class="btn btn-outline-secondary" id="btnZoomOut">-</button>
            <button type="button" class="btn btn-outline-secondary" id="btnZoomFit">Fit</button>
            <button type="button" class="btn btn-outline-secondary" id="btnZoomIn">+</button>
        </div>

        <div class="ms-auto" style="min-width: 220px;">
            <input type="text" class="form-control form-control-sm" id="diagramTitle" maxlength="200" placeholder="Drawing title" value="@Model.Diagram.Title" />
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-9">
            <div id="pidCanvas"></div>
            <div class="small text-muted mt-1">
                Drag equipment to move it. Drag a valve along its pipe. Select a pipe, then click a valve symbol to add one.
                Mouse wheel zooms, drag the background to pan.
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-header py-2">Properties</div>
                <div class="card-body py-2" id="pidProps"></div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-2">Symbols @(Model.IsReadOnly ? "" : "(click to add)")</div>
                <div class="card-body py-2" id="pidLegend"></div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-2">Approval</div>
                <div class="card-body py-2">
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="statusSelect">Status</label>
                        <select class="form-select form-select-sm" id="statusSelect">
                            @foreach (var s in statuses)
                            {
                                <option value="@s" selected="@(s == Model.Diagram.Status.ToString())">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="statusRemarks">Remarks</label>
                        <input type="text" class="form-control form-control-sm" id="statusRemarks" maxlength="500" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm" id="btnSetStatus">Apply status</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnNewRevision" disabled>New revision</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/undo-redo.js" asp-append-version="true"></script>
    <script src="~/js/pid-symbols.js" asp-append-version="true"></script>
    <script src="~/js/pid-editor.js" asp-append-version="true"></script>
}