@model BiogasApp.Model.ViewModel.PidEditorViewModel
@using BiogasApp.Database.Enums
@{
    ViewData["Title"] = "P&ID";
    var hasDiagram = Model.PidDiagramId.HasValue;
    var hasRuns = Model.AvailableRuns.Count > 0;
    var error = TempData["PidError"] as string;

    string BadgeClass(PidApprovalStatus s) => s switch
    {
        PidApprovalStatus.Approved => "text-bg-success",
        PidApprovalStatus.InReview => "text-bg-warning",
        PidApprovalStatus.Rejected => "text-bg-danger",
        PidApprovalStatus.Superseded => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}

<div class="pid-index">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">P&amp;ID</h1>
            <div class="text-muted">@Model.ProjectName</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger py-2 small">@error</div>
    }

    @if (!hasRuns)
    {
        <div class="alert alert-info">
            No simulation run found for this project. Run a simulation first.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header">Simulation run</div>
            <div class="card-body">
                <form method="get" asp-action="Index" asp-controller="Pid" class="row g-2 align-items-end">
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1" for="runId">Pipe sizes are taken from this run</label>
                        <select class="form-select form-select-sm" id="runId" name="runId" onchange="this.form.submit()">
                            @foreach (var r in Model.AvailableRuns)
                            {
                                <option value="@r.SimulationRunId" selected="@(r.SimulationRunId == Model.SimulationRunId)">
                                    Run v@(r.RunVersion) - @r.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Show</button>
                    </div>
                </form>

                <form method="post" asp-action="Generate" asp-controller="Pid" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <input type="hidden" name="simulationRunId" value="@Model.SimulationRunId" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        @(hasDiagram ? "Generate new P&ID for this run" : "Generate P&ID")
                    </button>
                </form>
            </div>
        </div>
    }

    @if (hasDiagram)
    {
        <div class="card mb-3">
            <div class="card-header">Current drawing for this run</div>
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div><strong>@Model.Diagram.DrawingNo</strong> - @Model.Diagram.Title</div>
                        <div class="small text-muted">
                            Revision @Model.Diagram.RevisionNo
                            <span class="badge @BadgeClass(Model.Diagram.Status)">@Model.Diagram.Status</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary btn-sm" asp-action="Editor" asp-controller="Pid" asp-route-id="@Model.PidDiagramId">Open editor</a>
                        <a class="btn btn-outline-primary btn-sm" asp-action="ExportExcel" asp-controller="Pid" asp-route-id="@Model.PidDiagramId">Download lists (Excel)</a>
                        <form method="post" asp-action="Delete" asp-controller="Pid" asp-route-id="@Model.PidDiagramId"
                              onsubmit="return confirm('Delete this P&ID and all its revisions?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Revision history</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Rev</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Changed by</th>
                            <th>Changed at</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Revisions.Any())
                        {
                            <tr><td colspan="5" class="text-muted small">No revisions yet.</td></tr>
                        }
                        @foreach (var rev in Model.Revisions)
                        {
                            <tr>
                                <td>@rev.RevisionNo</td>
                                <td><span class="badge @BadgeClass(rev.Status)">@rev.Status</span></td>
                                <td>@rev.Remarks</td>
                                <td>@rev.ChangedBy</td>
                                <td>@rev.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (hasRuns)
    {
        <div class="alert alert-secondary small">No P&amp;ID has been generated for this run yet.</div>
    }
</div>