@model BiogasApp.Model.DTOs.EquipmentDatasheetSetDto
@using BiogasApp.Model.DTOs
@{
    ViewData["Title"] = "Datasheets";
    var selectedTag = ViewData["SelectedTag"] as string;
    var view = (ViewData["View"] as string ?? "epc").ToLowerInvariant();
    if (view != "client" && view != "vendor") { view = "epc"; }
    var isEpc = view == "epc";
    var isClient = view == "client";
    var isVendor = view == "vendor";

    var item = Model.Items.FirstOrDefault(i => string.Equals(i.Tag, selectedTag, StringComparison.OrdinalIgnoreCase))
               ?? Model.Items.FirstOrDefault();

    var groups = new List<(string Title, List<DatasheetFieldDto> Fields)>();
    if (item != null)
    {
        groups.Add(("Process data", item.Process));
        groups.Add(("Mechanical data", item.Mechanical));
        if (isEpc || isVendor)
        {
            groups.Add(("Utilities", item.Utilities));
        }
        if (!isVendor)
        {
            groups.Add(("Notes", item.Notes));
        }
    }

    var hasLayout = item != null && (item.Zone != null || item.HazardClass != null || item.DiameterM.HasValue || item.WidthM.HasValue || item.LengthM.HasValue);

    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    string Num(decimal? v) => v.HasValue ? v.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : "-";
}

@section Styles {
    <style>
        .ds-badge {
            background: #FFF1C9;
            color: #7A4B00;
            border: 1px solid #FFD27A;
            font-size: .75rem;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 999px;
            letter-spacing: .3px;
        }

        .ds-seg {
            display: inline-flex;
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: 999px;
            padding: 4px;
            box-shadow: var(--bp-shadow);
        }

            .ds-seg a {
                padding: 8px 20px;
                border-radius: 999px;
                color: var(--bp-ink-soft);
                font-weight: 700;
                font-size: .9rem;
                text-decoration: none;
            }

                .ds-seg a:hover {
                    background: var(--bp-tint-2);
                    color: var(--bp-ink);
                }

                .ds-seg a.on {
                    background: var(--bp-grad-deep);
                    color: #fff;
                    box-shadow: 0 6px 14px rgba(3, 105, 161, .3);
                }

        .ds-tagpill {
            display: inline-block;
            min-width: 66px;
            text-align: center;
            padding: 3px 8px;
            border-radius: 7px;
            background: var(--bp-tint);
            color: var(--bp-ink);
            font-family: var(--bp-font-display);
            font-size: .8rem;
            font-weight: 700;
            margin-right: 8px;
        }

        .list-group-item.active .ds-tagpill {
            background: rgba(255, 255, 255, .25);
            color: #fff;
        }

        .ds-tag {
            display: inline-block;
            background: var(--bp-tint);
            color: #2531B8;
            font-size: .75rem;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 999px;
            border: 1px solid var(--bp-line);
            letter-spacing: .3px;
        }

        .ds-title {
            font-family: var(--bp-font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--bp-ink);
            letter-spacing: -.3px;
        }

        .ds-chip {
            height: 100%;
            border: 1px solid var(--bp-line);
            background: linear-gradient(180deg, #fff, var(--bp-tint-2));
            border-radius: 12px;
            padding: 12px 14px;
            font-family: var(--bp-font-display);
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--bp-ink);
        }

            .ds-chip small {
                display: block;
                font-family: var(--bp-font);
                color: var(--bp-ink-mute);
                font-size: .72rem;
                font-weight: 700;
                margin-bottom: 4px;
                text-transform: uppercase;
                letter-spacing: .6px;
            }

        .ds-w45 {
            width: 45%;
        }

        .ds-fill {
            background: #FFF2CC;
        }

        .table td, .table th {
            font-size: 1rem;
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="mb-0">Datasheets</h1>
        <div class="text-muted d-flex align-items-center gap-2">
            @Model.ProjectName - @Model.DrawingNo
            <span>Rev @Model.RevisionNo</span>
            <span class="ds-badge">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="DatasheetProjects">Back</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="Editor" asp-route-id="@Model.PidDiagramId">Open P&amp;ID editor</a>
        <div class="dropdown">
            <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">All equipment</h6></li>
                <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetExcel" asp-route-id="@Model.PidDiagramId" asp-route-view="@view">Excel</a></li>
                <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetPdf" asp-route-id="@Model.PidDiagramId" asp-route-view="@view">PDF</a></li>
                @if (item != null)
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li><h6 class="dropdown-header">@item.Tag only</h6></li>
                    <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetExcel" asp-route-id="@Model.PidDiagramId" asp-route-tag="@item.Tag" asp-route-view="@view">Excel</a></li>
                    <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetPdf" asp-route-id="@Model.PidDiagramId" asp-route-tag="@item.Tag" asp-route-view="@view">PDF</a></li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="ds-seg mb-3" role="group" aria-label="Datasheet view">
    <a class="@(isEpc ? "on" : "")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="epc">EPC</a>
    <a class="@(isClient ? "on" : "")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="client">Client</a>
    <a class="@(isVendor ? "on" : "")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="vendor">Vendor RFQ</a>
</div>

@if (item == null)
{
    <div class="alert alert-info py-2">No equipment on this drawing.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header py-2">Equipment</div>
                <div class="list-group list-group-flush">
                    @foreach (var i in Model.Items)
                    {
                        var active = string.Equals(i.Tag, item.Tag, StringComparison.OrdinalIgnoreCase);
                        <a class="list-group-item list-group-item-action py-2 @(active ? "active" : "")"
                           asp-controller="Pid" asp-action="DatasheetPage"
                           asp-route-id="@Model.PidDiagramId" asp-route-tag="@i.Tag" asp-route-view="@view">
                            <span class="ds-tagpill">@i.Tag</span>@i.Name
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h2 class="ds-title mb-2">@item.Tag - @item.Name</h2>
                            <span class="ds-tag">@item.EquipmentType</span> <span class="ds-tag">qty @item.Quantity</span>
                        </div>
                    </div>

                    @if (hasLayout)
                    {
                        <div class="row g-2">
                            <div class="col-6 col-md-3"><div class="ds-chip"><small>Zone</small>@Dash(item.Zone)</div></div>
                            <div class="col-6 col-md-3"><div class="ds-chip"><small>Hazard class</small>@Dash(item.HazardClass)</div></div>
                            <div class="col-6 col-md-3"><div class="ds-chip"><small>Diameter (m)</small>@Num(item.DiameterM)</div></div>
                            <div class="col-6 col-md-3"><div class="ds-chip"><small>Width x length (m)</small>@Num(item.WidthM) x @Num(item.LengthM)</div></div>
                        </div>
                    }
                </div>
            </div>

            @foreach (var g in groups)
            {
                if (g.Fields.Count == 0) { continue; }
                <div class="card mb-3">
                    <div class="card-header py-2">@g.Title</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var f in g.Fields)
                                {
                                    <tr>
                                        <td class="ds-w45">@f.Label</td>
                                        <td>@Dash(f.Value) @f.Unit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.Instruments.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Instruments</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Tag</th><th>Type</th><th>Service</th><th>Range</th><th>Unit</th></tr></thead>
                            <tbody>
                                @foreach (var i in item.Instruments.OrderBy(x => x.Tag))
                                {
                                    <tr>
                                        <td>@i.Tag</td>
                                        <td>@i.InstrumentType</td>
                                        <td>@Dash(i.Service)</td>
                                        <td>@Num(i.RangeMin) - @Num(i.RangeMax)</td>
                                        <td>@Dash(i.Unit)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.ConnectedLines.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Connected lines</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Line no</th><th>Medium</th><th>Size DN (mm)</th><th>Material</th><th>Insulated</th></tr></thead>
                            <tbody>
                                @foreach (var l in item.ConnectedLines)
                                {
                                    <tr>
                                        <td>@l.LineNo</td>
                                        <td>@l.Medium</td>
                                        <td>@Num(l.NominalSizeMm)</td>
                                        <td>@Dash(l.Material)</td>
                                        <td>@(l.IsInsulated ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.Valves.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Valves on connected lines</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Tag</th><th>Type</th><th>Size DN (mm)</th><th>Normal position</th></tr></thead>
                            <tbody>
                                @foreach (var v in item.Valves.OrderBy(x => x.Tag))
                                {
                                    <tr>
                                        <td>@v.Tag</td>
                                        <td>@v.ValveType</td>
                                        <td>@Num(v.NominalSizeMm)</td>
                                        <td>@(v.IsNormallyOpen ? "Open" : "Closed")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (isEpc)
            {
                <div class="card mb-3">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span>Vendor data</span>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="Editor" asp-route-id="@Model.PidDiagramId">Edit in P&amp;ID editor</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="ds-w45">Make</td><td>@Dash(item.Vendor.Make)</td></tr>
                                <tr><td>Model</td><td>@Dash(item.Vendor.Model)</td></tr>
                                <tr><td>Material</td><td>@Dash(item.Vendor.Material)</td></tr>
                                <tr><td>Weight (kg)</td><td>@Num(item.Vendor.WeightKg)</td></tr>
                                <tr><td>Price</td><td>@Num(item.Vendor.Price) @item.Vendor.Currency</td></tr>
                                <tr><td>Delivery (weeks)</td><td>@(item.Vendor.DeliveryWeeks?.ToString() ?? "-")</td></tr>
                                <tr><td>Remarks</td><td>@Dash(item.Vendor.Remarks)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (isVendor)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Vendor data (to be filled by vendor)</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="ds-w45">Make</td><td class="ds-fill">&nbsp;</td></tr>
                                <tr><td>Model</td><td class="ds-fill">&nbsp;</td></tr>
                                <tr><td>Material</td><td class="ds-fill">&nbsp;</td></tr>
                                <tr><td>Weight (kg)</td><td class="ds-fill">&nbsp;</td></tr>
                                <tr><td>Price</td><td class="ds-fill">&nbsp;</td></tr>
                                <tr><td>Delivery (weeks)</td><td class="ds-fill">&nbsp;</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
}