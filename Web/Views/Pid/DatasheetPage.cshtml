@model BiogasApp.Model.DTOs.EquipmentDatasheetSetDto
@using BiogasApp.Model.DTOs
@{
    ViewData["Title"] = "Datasheets";
    var selectedTag = ViewData["SelectedTag"] as string;
    var view = (ViewData["View"] as string ?? "epc").ToLowerInvariant();
    if (view != "client" && view != "vendor") { view = "epc"; }
    var isEpc = view == "epc";
    var isClient = view == "client";
    var isVendor = view == "vendor";

    var item = Model.Items.FirstOrDefault(i => string.Equals(i.Tag, selectedTag, StringComparison.OrdinalIgnoreCase))
               ?? Model.Items.FirstOrDefault();

    var groups = new List<(string Title, List<DatasheetFieldDto> Fields)>();
    if (item != null)
    {
        groups.Add(("Process data", item.Process));
        groups.Add(("Mechanical data", item.Mechanical));
        if (isEpc || isVendor)
        {
            groups.Add(("Utilities", item.Utilities));
        }
        if (!isVendor)
        {
            groups.Add(("Notes", item.Notes));
        }
    }

    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    string Num(decimal? v) => v.HasValue ? v.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : "-";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h4 mb-0">Datasheets</h1>
        <div class="text-muted">
            @Model.ProjectName - @Model.DrawingNo
            <span>Rev @Model.RevisionNo</span>
            <span class="badge text-bg-secondary">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="DatasheetProjects">Back</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="Editor" asp-route-id="@Model.PidDiagramId">Open P&amp;ID editor</a>
        <div class="dropdown">
            <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">All equipment</h6></li>
                <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetExcel" asp-route-id="@Model.PidDiagramId" asp-route-view="@view">Excel</a></li>
                <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetPdf" asp-route-id="@Model.PidDiagramId" asp-route-view="@view">PDF</a></li>
                @if (item != null)
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li><h6 class="dropdown-header">@item.Tag only</h6></li>
                    <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetExcel" asp-route-id="@Model.PidDiagramId" asp-route-tag="@item.Tag" asp-route-view="@view">Excel</a></li>
                    <li><a class="dropdown-item" asp-controller="Pid" asp-action="ExportDatasheetPdf" asp-route-id="@Model.PidDiagramId" asp-route-tag="@item.Tag" asp-route-view="@view">PDF</a></li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="btn-group btn-group-sm mb-3" role="group" aria-label="Datasheet view">
    <a class="btn @(isEpc ? "btn-primary" : "btn-outline-primary")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="epc">EPC</a>
    <a class="btn @(isClient ? "btn-primary" : "btn-outline-primary")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="client">Client</a>
    <a class="btn @(isVendor ? "btn-primary" : "btn-outline-primary")" asp-controller="Pid" asp-action="DatasheetPage"
       asp-route-id="@Model.PidDiagramId" asp-route-tag="@item?.Tag" asp-route-view="vendor">Vendor RFQ</a>
</div>

@if (item == null)
{
    <div class="alert alert-info py-2 small">No equipment on this drawing.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header py-2">Equipment</div>
                <div class="list-group list-group-flush">
                    @foreach (var i in Model.Items)
                    {
                        var active = string.Equals(i.Tag, item.Tag, StringComparison.OrdinalIgnoreCase);
                        <a class="list-group-item list-group-item-action py-2 small @(active ? "active" : "")"
                           asp-controller="Pid" asp-action="DatasheetPage"
                           asp-route-id="@Model.PidDiagramId" asp-route-tag="@i.Tag" asp-route-view="@view">
                            <strong>@i.Tag</strong> - @i.Name
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h2 class="h5 mb-0">@item.Tag - @item.Name</h2>
                            <div class="small text-muted">@item.EquipmentType, qty @item.Quantity</div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Zone</div><div>@Dash(item.Zone)</div></div></div>
                        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Hazard class</div><div>@Dash(item.HazardClass)</div></div></div>
                        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Diameter (m)</div><div>@Num(item.DiameterM)</div></div></div>
                        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Width x length (m)</div><div>@Num(item.WidthM) x @Num(item.LengthM)</div></div></div>
                    </div>
                </div>
            </div>

            @foreach (var g in groups)
            {
                if (g.Fields.Count == 0) { continue; }
                <div class="card mb-3">
                    <div class="card-header py-2">@g.Title</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var f in g.Fields)
                                {
                                    <tr>
                                        <td class="text-muted" style="width: 45%;">@f.Label</td>
                                        <td>@Dash(f.Value) @f.Unit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.Instruments.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Instruments</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Tag</th><th>Type</th><th>Service</th><th>Range</th><th>Unit</th></tr></thead>
                            <tbody>
                                @foreach (var i in item.Instruments.OrderBy(x => x.Tag))
                                {
                                    <tr>
                                        <td>@i.Tag</td>
                                        <td>@i.InstrumentType</td>
                                        <td>@Dash(i.Service)</td>
                                        <td>@Num(i.RangeMin) - @Num(i.RangeMax)</td>
                                        <td>@Dash(i.Unit)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.ConnectedLines.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Connected lines</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Line no</th><th>Medium</th><th>Size DN (mm)</th><th>Material</th><th>Insulated</th></tr></thead>
                            <tbody>
                                @foreach (var l in item.ConnectedLines)
                                {
                                    <tr>
                                        <td>@l.LineNo</td>
                                        <td>@l.Medium</td>
                                        <td>@Num(l.NominalSizeMm)</td>
                                        <td>@Dash(l.Material)</td>
                                        <td>@(l.IsInsulated ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if ((isEpc || isVendor) && item.Valves.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Valves on connected lines</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Tag</th><th>Type</th><th>Size DN (mm)</th><th>Normal position</th></tr></thead>
                            <tbody>
                                @foreach (var v in item.Valves.OrderBy(x => x.Tag))
                                {
                                    <tr>
                                        <td>@v.Tag</td>
                                        <td>@v.ValveType</td>
                                        <td>@Num(v.NominalSizeMm)</td>
                                        <td>@(v.IsNormallyOpen ? "Open" : "Closed")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (isEpc)
            {
                <div class="card mb-3">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span>Vendor data</span>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Pid" asp-action="Editor" asp-route-id="@Model.PidDiagramId">Edit in P&amp;ID editor</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="text-muted" style="width: 45%;">Make</td><td>@Dash(item.Vendor.Make)</td></tr>
                                <tr><td class="text-muted">Model</td><td>@Dash(item.Vendor.Model)</td></tr>
                                <tr><td class="text-muted">Material</td><td>@Dash(item.Vendor.Material)</td></tr>
                                <tr><td class="text-muted">Weight (kg)</td><td>@Num(item.Vendor.WeightKg)</td></tr>
                                <tr><td class="text-muted">Price</td><td>@Num(item.Vendor.Price) @item.Vendor.Currency</td></tr>
                                <tr><td class="text-muted">Delivery (weeks)</td><td>@(item.Vendor.DeliveryWeeks?.ToString() ?? "-")</td></tr>
                                <tr><td class="text-muted">Remarks</td><td>@Dash(item.Vendor.Remarks)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (isVendor)
            {
                <div class="card mb-3">
                    <div class="card-header py-2">Vendor data (to be filled by vendor)</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="text-muted" style="width: 45%;">Make</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                                <tr><td class="text-muted">Model</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                                <tr><td class="text-muted">Material</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                                <tr><td class="text-muted">Weight (kg)</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                                <tr><td class="text-muted">Price</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                                <tr><td class="text-muted">Delivery (weeks)</td><td style="background:#FFF2CC;">&nbsp;</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
}