@using System.Globalization
@using BiogasApp.Database.Enums
@using Web.Helpers
@model ProjectStatus
@{
    var uid = Guid.NewGuid().ToString("N").Substring(0, 6);
    var pct = Model.FillPercent();
    var archived = Model == ProjectStatus.Archived;
    var gas = Model == ProjectStatus.Simulated || Model == ProjectStatus.Approved;

    const double tankTop = 38d;
    const double tankHeight = 40d;
    var fillHeight = tankHeight * pct / 100d;
    var fillY = (tankTop + tankHeight - fillHeight).ToString("0.##", CultureInfo.InvariantCulture);
    var fillH = fillHeight.ToString("0.##", CultureInfo.InvariantCulture);

    var domeFill = gas ? "url(#gas-" + uid + ")" : "#E4ECFF";
    var dash = archived ? "4 3" : null;
}
<svg class="pj-digester@(archived ? " is-archived" : "")" viewBox="0 0 80 90" role="img" aria-label="Biogas plant fill @pct% - @Model.Label()" focusable="false">
    <defs>
        <linearGradient id="liq-@uid" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#00C48C" />
            <stop offset=".55" stop-color="#10B5E8" />
            <stop offset="1" stop-color="#5B5BF0" />
        </linearGradient>
        <linearGradient id="gas-@uid" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFD36B" />
            <stop offset="1" stop-color="#FF5E7E" />
        </linearGradient>
        <clipPath id="clip-@uid">
            <rect x="10" y="38" width="48" height="40" rx="5" />
        </clipPath>
    </defs>
    <rect x="6" y="78" width="56" height="6" rx="3" fill="#C9D6F2" />
    <rect x="10" y="38" width="48" height="40" rx="5" fill="#FFFFFF" />
    @if (pct > 0)
    {
        <g clip-path="url(#clip-@uid)">
            <rect x="10" y="@fillY" width="48" height="@fillH" fill="url(#liq-@uid)" />
            <rect x="10" y="@fillY" width="48" height="1.5" fill="#FFFFFF" opacity=".55" />
            <circle cx="22" cy="70" r="2.2" fill="#FFFFFF" opacity=".6" />
            <circle cx="34" cy="63" r="1.6" fill="#FFFFFF" opacity=".6" />
            <circle cx="46" cy="71" r="2.6" fill="#FFFFFF" opacity=".6" />
            <circle cx="40" cy="56" r="1.4" fill="#FFFFFF" opacity=".6" />
        </g>
    }
    <rect x="10" y="38" width="48" height="40" rx="5" fill="none" stroke="#9FB3E6" stroke-width="1.5" stroke-dasharray="@dash" />
    <path d="M10 40A24 20 0 0 1 58 40Z" fill="@domeFill" stroke="#9FB3E6" stroke-width="1.5" stroke-dasharray="@dash" />
    <path d="M34 20V12H66V16" fill="none" stroke="#9FB3E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="@dash" />
    <path d="M66 15C60 22 59 28 63 31C64.5 32.2 67.5 32.2 69 31C73 28 72 22 66 15Z" fill="@domeFill" stroke="#9FB3E6" stroke-width="1.2" stroke-dasharray="@dash" />
</svg>