@using BiogasApp.Database.Enums
@using Web.Helpers
@model BiogasApp.Database.Entities.Project
@{
    ViewData["Title"] = Model.Name;
    ViewData["WorkflowStep"] = Model.Status == ProjectStatus.Draft ? 2 : Model.Status == ProjectStatus.Simulated ? 3 : 7;
    var mix = Model.FeedstockMix.OrderByDescending(m => m.DailyTonnageTpd).ToList();
    var totalTpd = mix.Sum(m => m.DailyTonnageTpd);

    var lifecycle = new[] { ProjectStatus.Draft, ProjectStatus.Simulated, ProjectStatus.Approved };
    var currentStep = Array.IndexOf(lifecycle, Model.Status);

    const int tempMin = -50;
    const int tempMax = 60;
    var from = (int)Math.Round(((double)Model.AmbientTempMinC - tempMin) / (tempMax - tempMin) * 100);
    var to = (int)Math.Round(((double)Model.AmbientTempMaxC - tempMin) / (tempMax - tempMin) * 100);
    from = Math.Clamp(from, 0, 100);
    to = Math.Clamp(to, 0, 100);
}
@section Styles {
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
}


<section class="pj-hero bp-card" aria-labelledby="pj-title">
    <div class="pj-hero__tank">
        <partial name="_Digester" model="Model.Status" />
    </div>
    <div class="pj-hero__main">
        <span class="bp-chip bp-chip--@(Model.Status.Css())">@Model.Status.Label()</span>
        <h1 id="pj-title" class="pj-hero__title">@Model.Name</h1>
        <p class="bp-muted mb-0">@Model.LocationCountry, created @Model.CreatedAt.ToString("dd MMM yyyy")</p>

        <div class="pj-hero__actions">
            <a class="bp-btn bp-btn--flame" asp-controller="Simulation" asp-action="Mixer" asp-route-projectId="@Model.Id">Open feedstock mixer</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Workflow" asp-action="Checklist" asp-route-projectId="@Model.Id">Project checklist</a>
            <a class="bp-btn bp-btn--ghost" asp-controller="Simulation" asp-action="History" asp-route-projectId="@Model.Id">Simulation history</a>
            <a class="bp-btn bp-btn--ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit details</a>
        </div>
    </div>

    <ol class="pj-life" aria-label="Project lifecycle">
        @for (var i = 0; i < lifecycle.Length; i++)
        {
            var state = i < currentStep ? "done" : (i == currentStep ? "current" : "next");
            <li class="pj-life__step is-@state" aria-current="@(state == "current" ? "step" : null)">
                <span class="pj-life__name">@lifecycle[i].Label()</span>
                <span class="pj-life__state">@(state == "done" ? "Done" : (state == "current" ? "Current" : "Upcoming"))</span>
            </li>
        }
    </ol>
    @if (Model.Status == ProjectStatus.Archived)
    {
        <p class="pj-archived-note bp-muted mb-0">This project is archived and sits outside the active lifecycle.</p>
    }
</section>

<div class="pj-columns">
    <section class="bp-card" aria-labelledby="pj-process">
        <h2 id="pj-process" class="pj-card-title">Process</h2>
        <dl class="pj-spec">
            <div>
                <dt>Regulatory code</dt>
                <dd>@Model.RegulatoryStandard.Label()<small>@Model.RegulatoryStandard.Hint()</small></dd>
            </div>
            <div>
                <dt>Digester regime</dt>
                <dd>@Model.DigesterRegime.Label()<small>@Model.DigesterRegime.Hint()</small></dd>
            </div>
            <div>
                <dt>Upgrading technology</dt>
                <dd>@Model.UpgradingTech.Label()<small>@Model.UpgradingTech.Hint()</small></dd>
            </div>
            <div>
                <dt>Ambient temperature</dt>
                <dd>
                    @Model.AmbientTempMinC.ToString("0.#") &deg;C to @Model.AmbientTempMaxC.ToString("0.#") &deg;C
                    <span class="pj-thermo" aria-hidden="true"><span class="pj-thermo__span" style="--pj-from:@(from)%;--pj-to:@(to)%"></span></span>
                </dd>
            </div>
        </dl>
    </section>
</div>

<section class="bp-card pj-mix" aria-labelledby="pj-mix-title">
    <div class="pj-section-head">
        <div>
            <h2 id="pj-mix-title" class="pj-card-title">Feedstock mix</h2>
            @if (mix.Count > 0)
            {
                <p class="bp-muted mb-0">
                    Total feed <strong>@totalTpd.ToString("0.##") t/day</strong> across @mix.Count @(mix.Count == 1 ? "feedstock" : "feedstocks")
                </p>
            }
        </div>
        <a class="bp-btn bp-btn--ghost" asp-controller="Simulation" asp-action="Mixer" asp-route-projectId="@Model.Id">Adjust in mixer</a>
    </div>

    @if (mix.Count == 0)
    {
        <div class="pj-mix__empty">
            <h3>No feedstock yet</h3>
            <p class="bp-muted">Blend your first feedstock in the mixer to see the mix and run a simulation.</p>
            <a class="bp-btn bp-btn--flame" asp-controller="Simulation" asp-action="Mixer" asp-route-projectId="@Model.Id">Start blending</a>
        </div>
    }
    else
    {
        <ul class="pj-bubbles" role="list">
            @foreach (var m in mix)
            {
                var share = totalTpd > 0 ? (double)(m.DailyTonnageTpd / totalTpd) : 0d;
                var size = 88 + (int)Math.Round(share * 96);
                var category = m.Feedstock?.Category;
                <li class="pj-bubble-wrap" style="--pj-size:@(size)px">
                    <span class="pj-bubble pj-bubble--@(category?.Css() ?? "agro")">
                        <strong>@m.DailyTonnageTpd.ToString("0.##")</strong>
                        <small>t/day</small>
                    </span>
                    <span class="pj-bubble__name">@(m.Feedstock?.Name ?? "Feedstock")</span>
                    <span class="pj-bubble__meta">
                        @(category?.Label()), @((int)Math.Round(share * 100))% of feed
                        @if (m.SeasonalAvailabilityDays != 365)
                        {
                            <text>, @m.SeasonalAvailabilityDays days a year</text>
                        }
                    </span>
                </li>
            }
        </ul>
    }
</section>

<section class="pj-danger-zone" aria-label="Delete project">
    <button type="button" class="bp-btn bp-btn--ghost" data-bs-toggle="modal" data-bs-target="#pj-delete">Delete project</button>
</section>

<div class="modal fade" id="pj-delete" tabindex="-1" aria-labelledby="pj-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pj-modal">
            <div class="modal-header border-0">
                <h2 class="modal-title fs-4" id="pj-delete-title">Delete this project?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">You are about to delete <strong>@Model.Name</strong>. This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="bp-btn bp-btn--ghost" data-bs-dismiss="modal">Keep project</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="bp-btn pj-btn-danger">Delete project</button>
                </form>
            </div>
        </div>
    </div>
</div>